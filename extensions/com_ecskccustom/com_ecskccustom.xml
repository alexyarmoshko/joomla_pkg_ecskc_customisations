<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
    <name>com_ecskccustom</name>
    <author>Yak Shaver</author>
    <creationDate>2026-08</creationDate>
    <copyright>(C) 2026 Yak Shaver https://www.kayakshaver.com</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE</license>
    <authorEmail>me@kayakshaver.com</authorEmail>
    <authorUrl>https://www.kayakshaver.com</authorUrl>
    <version>0.1.0</version>
    <description>COM_ECSKCCUSTOM_XML_DESCRIPTION</description>
    <namespace path="src">YakShaver\Component\ECSKCCustomisation</namespace>
    <!--
        The installer resolves scriptfile against the package root, while uninstall
        re-reads it from the installed administrator folder (ComponentAdapter sets
        source to extension_administrator there). The script therefore ships twice,
        from one source file: once at the archive root for install, and once inside
        admin/ so uninstall can still find it. The build owns that duplication.
    -->
    <scriptfile>script.php</scriptfile>

    <!--
        Administrator only. The plan keeps every package code path in the
        administrator and in the installer event; the site plugin that delivers
        override.css is a separate extension, added in Phase 4.

        payload/ and rules/ are declared, so a package update replaces them with the
        new release's files. Both ship empty for now; ticket 18 authors the rule set
        and payload inventory into them, and PackagePaths::rules() already points
        here. backup/, staging/ and state/ are deliberately NOT
        declared: Joomla removes files by comparing the old and new manifests and
        ignores what appears in neither, which is what carries a site's backups,
        freeze markers and event log across an update. None of the three survives
        uninstall, and that is the documented data-loss boundary.
    -->
    <administration>
        <files folder="admin">
            <filename>script.php</filename>
            <folder>language</folder>
            <folder>payload</folder>
            <folder>rules</folder>
            <folder>schema</folder>
            <folder>services</folder>
            <folder>src</folder>
        </files>
        <languages folder="admin">
            <language tag="en-GB">language/en-GB/com_ecskccustom.ini</language>
            <language tag="en-GB">language/en-GB/com_ecskccustom.sys.ini</language>
        </languages>
    </administration>
</extension>
