<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_ECSKCCUSTOM_PLUGINS_FILTER_SEARCH_LABEL"
            description="COM_ECSKCCUSTOM_PLUGINS_FILTER_SEARCH_DESC"
            hint="COM_ECSKCCUSTOM_PLUGINS_FILTER_SEARCH_HINT"
        />
    </fields>
    <!-- The values are RegistryResolver::SORTABLE, each way. The limit's default is the
         site's global list limit, which ListModel puts in the state on a first visit. -->
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            class="js-select-submit-on-change"
            default="name ASC"
            validate="options"
            >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="name ASC">JGLOBAL_NAME_ASC</option>
            <option value="name DESC">JGLOBAL_NAME_DESC</option>
            <option value="type ASC">COM_ECSKCCUSTOM_PLUGINS_SORT_TYPE_ASC</option>
            <option value="type DESC">COM_ECSKCCUSTOM_PLUGINS_SORT_TYPE_DESC</option>
            <option value="version ASC">COM_ECSKCCUSTOM_PLUGINS_SORT_VERSION_ASC</option>
            <option value="version DESC">COM_ECSKCCUSTOM_PLUGINS_SORT_VERSION_DESC</option>
            <option value="status ASC">JSTATUS_ASC</option>
            <option value="status DESC">JSTATUS_DESC</option>
            <option value="update ASC">COM_ECSKCCUSTOM_PLUGINS_SORT_UPDATE_ASC</option>
            <option value="update DESC">COM_ECSKCCUSTOM_PLUGINS_SORT_UPDATE_DESC</option>
            <option value="package ASC">COM_ECSKCCUSTOM_PLUGINS_SORT_PACKAGE_ASC</option>
            <option value="package DESC">COM_ECSKCCUSTOM_PLUGINS_SORT_PACKAGE_DESC</option>
        </field>
        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            class="js-select-submit-on-change"
        />
    </fields>
</form>
