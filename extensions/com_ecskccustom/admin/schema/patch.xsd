<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <xs:simpleType name="hexDigest">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-fA-F]{32,128}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- One pattern: sibling xs:pattern entries are alternatives in XSD 1.0. -->
    <xs:simpleType name="relativePath">
        <xs:restriction base="xs:string">
            <xs:pattern value="([^/\\.\s]|[^/\\.\s][^/\\\s]|\.[^/\\.\s]|[^/\\\s]{3,})(/([^/\\.\s]|[^/\\.\s][^/\\\s]|\.[^/\\.\s]|[^/\\\s]{3,}))*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="targetPath">
        <xs:restriction base="xs:string">
            <xs:pattern value="/?([^/\\.\s]|[^/\\.\s][^/\\\s]|\.[^/\\.\s]|[^/\\\s]{3,})(/([^/\\.\s]|[^/\\.\s][^/\\\s]|\.[^/\\.\s]|[^/\\\s]{3,}))*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="rootPath">
        <xs:restriction base="xs:string">
            <xs:pattern value="|([^/\\.\s]|[^/\\.\s][^/\\\s]|\.[^/\\.\s]|[^/\\\s]{3,})(/([^/\\.\s]|[^/\\.\s][^/\\\s]|\.[^/\\.\s]|[^/\\\s]{3,}))*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="objectVersion">
        <xs:restriction base="xs:positiveInteger">
            <xs:maxInclusive value="2147483647"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="conditionAttribute">
        <xs:restriction base="xs:string">
            <xs:enumeration value="SITE_URL"/>
            <xs:enumeration value="HOST"/>
            <xs:enumeration value="JOOMLA_VERSION"/>
            <xs:enumeration value="PHP_VERSION"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="conditionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="literal"/>
            <xs:enumeration value="regex"/>
            <xs:enumeration value="version"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="matchMode">
        <xs:restriction base="xs:string">
            <xs:enumeration value="all"/>
            <xs:enumeration value="any"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="condition">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="type" type="conditionType" default="literal"/>
                <xs:attribute name="attribute" type="conditionAttribute" use="required"/>
                <xs:attribute name="description" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="conditions">
        <xs:choice minOccurs="1" maxOccurs="unbounded">
            <xs:element name="condition" type="condition"/>
            <xs:element name="conditions" type="conditions"/>
        </xs:choice>
        <xs:attribute name="match" type="matchMode" use="required"/>
    </xs:complexType>

    <xs:complexType name="copy">
        <xs:sequence>
            <xs:element name="srcPathFileName" type="relativePath"/>
            <xs:element name="sourceHash" type="hexDigest"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="remove">
        <xs:attribute name="backup" type="xs:boolean" default="true"/>
    </xs:complexType>

    <xs:complexType name="operations">
        <xs:choice minOccurs="1" maxOccurs="1">
            <xs:element name="copy" type="copy"/>
            <xs:element name="remove" type="remove"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="action">
        <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="conditions" type="conditions" minOccurs="0"/>
            <xs:element name="operations" type="operations"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="id">
        <xs:sequence>
            <xs:element name="destPathFileName" type="targetPath"/>
            <xs:element name="expectedHash" type="hexDigest" minOccurs="0"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="object">
        <xs:sequence>
            <xs:element name="id" type="id"/>
            <xs:element name="action" type="action" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="version" type="objectVersion" use="required"/>
        <xs:attribute name="create" type="xs:boolean" default="false"/>
        <xs:attribute name="replace" type="xs:boolean" default="true"/>
        <xs:attribute name="enable" type="xs:boolean" default="true"/>
    </xs:complexType>

    <xs:complexType name="root">
        <xs:sequence>
            <xs:element name="object" type="object" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="path" type="rootPath" use="required"/>
    </xs:complexType>

    <xs:element name="patch">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="description" type="xs:string" minOccurs="0"/>
                <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element name="root" type="root"/>
                    <xs:element name="object" type="object"/>
                </xs:choice>
            </xs:sequence>
            <xs:attribute name="hashType" type="xs:token" use="required"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
