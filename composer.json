{
    "name": "ecskc/customisations-package",
    "description": "Joomla package that deploys the ECSKC site customisations and re-applies them after extension upgrades",
    "type": "project",
    "license": "GPL-2.0-only",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "YakShaver\\Component\\ECSKCCustomisation\\Administrator\\": "extensions/com_ecskccustom/admin/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YakShaver\\ECSKCCustomisation\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
