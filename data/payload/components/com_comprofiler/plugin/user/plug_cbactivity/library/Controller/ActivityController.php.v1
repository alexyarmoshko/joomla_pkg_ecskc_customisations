	/**
	 * @return void
	 */
	public function bookmark(): void
	{
		global $_PLUGINS;

		$bookmarked		=	new ActivityBookmarkedTable();

		$bookmarked->load( [ 'activity_id' => $this->row->getId(), 'user_id' => $this->myId ] );

		if ( $bookmarked->getActivityId() ) {
			$this->ajax( CBTxt::T( 'You have already bookmarked this post.' ), 'error' );
		}

		$bookmarked->setActivityId( $this->row->getId() );
		$bookmarked->setUserId( $this->myId );

		$source			=	$this->row->getSource();

		$_PLUGINS->trigger( 'activity_onBeforeBookmarkStreamActivity', [ $this->rowStream, $source, &$bookmarked, $this->row ] );

		if ( $bookmarked->getError() || ( ! $bookmarked->check() ) || ( ! $bookmarked->store() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_BOOKMARK_FAILED_TO_SAVE', 'Post failed to bookmark! Error: [error]', [ '[error]' => $bookmarked->getError() ] ), 'error' );
		}

		$this->row->set( '_bookmarked', true );

		$_PLUGINS->trigger( 'activity_onAfterBookmarkStreamActivity', [ $this->rowStream, $source, $bookmarked, $this->row ] );

		ActivityHelper::addActivityCache( $this->row );

		$template		=	$this->template;
		$stream			=	$this->stream;
		$row			=	$this->row;
		$rowStream		=	$this->rowStream;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container', $this->template );

		echo $this->headers();
		$html			=	ob_get_clean();

		$this->ajax( $html, 'html', 'replace', 'container' );
	}

