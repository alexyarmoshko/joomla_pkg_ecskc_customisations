	/**
	 * @param bool $isNew
	 * @return void
	 */
	private function savePrivacy( bool $isNew = true ): void
	{
		$privacy	=	PrivacyHelper::getPrivacy( $this->row, $this->rowStream );

		if ( ! $privacy ) {
			return;
		}

		if ( $isNew ) {
			$privacy->name( 'activity_privacy_' . $this->rowStream->getId() . '_0' );
		}

		$privacy->privacy( 'save' );
	}

	/**
	 * @return bool
	 */
	public function authorizedDelete(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->row && $this->rowStream->canDeleteActivity( $this->row ) );
	}

	/**
	 * @return void
	 */
	public function delete(): void
	{
		global $_PLUGINS;

		$source		=	$this->row->getSource();

		$_PLUGINS->trigger( 'activity_onBeforeActivityStreamDelete', [ $this->rowStream, $source, &$this->row ] );

		if ( $this->row->getError() || ( ! $this->row->canDelete() ) || ( ! $this->row->delete() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_FAILED_TO_DELETE', 'Post failed to delete! Error: [error]', [ '[error]' => $this->row->getError() ] ), 'error' );
		}

		$_PLUGINS->trigger( 'activity_onAfterActivityStreamDelete', [ $this->rowStream, $source, $this->row ] );

		$template	=	$this->template;
		$stream		=	$this->stream;
		$row		=	$this->row;
		$rowStream	=	$this->rowStream;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container_deleted', $this->template );
		$html		=	ob_get_clean();

		$this->ajax( $html, 'html', 'replace', 'container' );
	}

	/**
	 * @return bool
	 */
	public function authorizedPublish(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->row && $this->rowStream->canPublishActivity( $this->row ) );
	}

	/**
	 * @return void
	 */
	public function publish(): void
	{
		global $_PLUGINS;

		$source		=	$this->row->getSource();

		$_PLUGINS->trigger( 'activity_onBeforeActivityStreamPublish', [ $this->rowStream, $source, &$this->row ] );

		if ( $this->row->isReported() ) {
			$this->row->setReports( 0 );
		}

		$this->row->setPublished( 1 );

		if ( $this->row->getError() || ( ! $this->row->check() ) || ( ! $this->row->store() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_FAILED_TO_PUBLISH', 'Post failed to publish! Error: [error]', [ '[error]' => $this->row->getError() ] ), 'error' );
		}

		$_PLUGINS->trigger( 'activity_onAfterActivityStreamPublish', [ $this->rowStream, $source, $this->row ] );

		ActivityHelper::addActivityCache( $this->row );

		$template	=	$this->template;
		$stream		=	$this->stream;
		$row		=	$this->row;
		$rowStream	=	$this->rowStream;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container', $this->template );

		echo $this->headers();
		$html		=	ob_get_clean();

		$this->ajax( $html, 'html', 'replace', 'container' );
	}

	/**
	 * @return bool
	 */
	public function authorizedHide(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->myId && $this->row && $this->row->isPublished() && ( $this->row->getUserId() !== $this->myId ) && GlobalParams::getHidden() );
	}

	/**
	 * @return void
	 */
	public function hide(): void
	{
		global $_PLUGINS;

		$type				=	$this->input->getString( 'type', 'activity' );
		$hidden				=	new HiddenTable();

		switch ( $type ) {
			case 'user':
				if ( $this->row->getSystem() || ( ! GlobalParams::getHiddenUser() ) ) {
					$this->ajax( CBTxt::T( 'You do not have permission to hide this post.' ), 'error' );
				}

				$hideType	=	'activity.' . $type;
				$hideItem	=	$this->row->getUserId();
				break;
			case 'asset':
				if ( ! GlobalParams::getHiddenSimilar() ) {
					$this->ajax( CBTxt::T( 'You do not have permission to hide this post.' ), 'error' );
				}

				$hideType	=	'activity.' . $type;
				$hideItem	=	(string) $this->row->getAsset();
				break;
			case 'activity':
			default:
				if ( ! GlobalParams::getHiddenActivity() ) {
					$this->ajax( CBTxt::T( 'You do not have permission to hide this post.' ), 'error' );
				}

				$hideType	=	'activity';
				$hideItem	=	$this->row->getId();
				break;
		}

		$hidden->load( [ 'user_id' => $this->myId, 'type' => $hideType, ( $type === 'asset' ? 'asset' : 'object' ) => $hideItem ] );

		if ( $hidden->getId() ) {
			$this->ajax( CBTxt::T( 'You have already hidden this post.' ), 'error' );
		}

		$hidden->setUserId( $this->myId );
		$hidden->setType( $hideType );

		if ( $type === 'asset' ) {
			$hidden->setAsset( $hideItem );
			$hidden->setObject( $this->row->getId() );
		} else {
			$hidden->setObject( $hideItem );
		}

		$source				=	$this->row->getSource();

		$_PLUGINS->trigger( 'activity_onBeforeActivityStreamHide', [ $this->rowStream, $source, &$hidden, $this->row ] );

		if ( $hidden->getError() || ( ! $hidden->check() ) || ( ! $hidden->store() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_HIDE_FAILED_TO_SAVE', 'Post failed to hide! Error: [error]', [ '[error]' => $hidden->getError() ] ), 'error' );
		}

		switch ( $type ) {
			case 'user':
				$this->row->set( '_hidden_user', $hidden->getObject() );
				break;
			case 'asset':
				$this->row->set( '_hidden_asset', $hidden->getInitialAsset() );
				break;
			case 'activity':
			default:
				$this->row->set( '_hidden_id', $hidden->getObject() );
				break;
		}

		$_PLUGINS->trigger( 'activity_onAfterActivityStreamHide', [ $this->rowStream, $source, $hidden, $this->row ] );

		ActivityHelper::addActivityCache( $this->row );

		$template			=	$this->template;
		$stream				=	$this->stream;
		$row				=	$this->row;
		$rowStream			=	$this->rowStream;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container_hidden', $this->template );
		$html				=	ob_get_clean();

		$this->ajax( $html, 'html', 'replace', 'container' );
	}

	/**
	 * @return bool
	 */
	public function authorizedUnhide(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->myId && $this->row && $this->row->isPublished() && ( $this->row->getUserId() !== $this->myId ) && GlobalParams::getHidden() );
	}

	/**
	 * @return void
	 */
	public function unhide(): void
	{
		global $_PLUGINS;

		$hidden				=	new HiddenTable();

		switch ( $this->input->getString( 'type', 'activity' ) ) {
			case 'user':
				$hidden->load( [ 'user_id' => $this->myId, 'type' => 'activity.user', 'object' => $this->row->getUserId() ] );
				break;
			case 'asset':
				$hidden->load( [ 'user_id' => $this->myId, 'type' => 'activity.asset', 'asset' => (string) $this->row->getAsset() ] );
				break;
			case 'activity':
			default:
				$hidden->load( [ 'user_id' => $this->myId, 'type' => 'activity', 'object' => $this->row->getId() ] );
				break;
		}

		if ( ! $hidden->getId() ) {
			$this->ajax( CBTxt::T( 'You have not hidden this post.' ), 'error' );
		}

		$source				=	$this->row->getSource();

		$_PLUGINS->trigger( 'activity_onBeforeActivityStreamUnhide', [ $this->rowStream, $source, &$hidden, $this->row ] );

		if ( $hidden->getError() || ( ! $hidden->canDelete() ) || ( ! $hidden->delete() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_HIDE_FAILED_TO_DELETE', 'Post failed to unhide! Error: [error]', [ '[error]' => $hidden->getError() ] ), 'error' );
		}

		$this->row->set( '_hidden_id', null );
		$this->row->set( '_hidden_user', null );
		$this->row->set( '_hidden_asset', null );

		$_PLUGINS->trigger( 'activity_onAfterActivityStreamUnhide', [ $this->rowStream, $source, $hidden, $this->row ] );

		ActivityHelper::addActivityCache( $this->row );

		$template			=	$this->template;
		$stream				=	$this->stream;
		$row				=	$this->row;
		$rowStream			=	$this->rowStream;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container', $this->template );

		echo $this->headers();
		$html				=	ob_get_clean();

		$this->ajax( $html, 'html', 'replace', 'container' );
	}

	/**
	 * @return bool
	 */
	public function authorizedFollow(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->myId && $this->row && $this->row->isPublished() && ( $this->row->getUserId() !== $this->myId ) && $this->rowStream->getParams()->getFollow() );
	}

	/**
	 * @return void
	 */
	public function follow(): void
	{
		global $_PLUGINS;

		$type			=	$this->input->getString( 'type', 'user' );
		$follow			=	new FollowTable();

		switch ( $type ) {
			case 'asset':
				if ( ! $this->rowStream->getParams()->getFollowSimilar() ) {
					$this->ajax( CBTxt::T( 'You do not have permission to follow this post.' ), 'error' );
				}

				$asset	=	(string) $this->row->getAsset();
				break;
			case 'user':
			default:
				if ( ! $this->rowStream->getParams()->getFollowUser() ) {
					$this->ajax( CBTxt::T( 'You do not have permission to follow this post.' ), 'error' );
				}

				$asset	=	'profile.' . $this->row->getUserId();
				break;
		}

		$follow->load( [ 'user_id' => $this->myId, 'asset' => $asset ] );

		if ( $follow->getId() ) {
			$this->ajax( CBTxt::T( 'You have already followed this post.' ), 'error' );
		}

		$follow->setUserId( $this->myId );
		$follow->setAsset( $asset );

		$source			=	$this->row->getSource();

		$_PLUGINS->trigger( 'activity_onBeforeFollowStreamActivity', [ $this->rowStream, $source, &$follow, $this->row ] );

		if ( $follow->getError() || ( ! $follow->check() ) || ( ! $follow->store() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_FOLLOW_FAILED_TO_SAVE', 'Post failed to follow! Error: [error]', [ '[error]' => $follow->getError() ] ), 'error' );
		}

		switch ( $type ) {
			case 'asset':
				$this->row->set( '_following', true );
				break;
			case 'user':
			default:
				$this->row->set( '_following_user', true );
				break;
		}

		$_PLUGINS->trigger( 'activity_onAfterFollowStreamActivity', [ $this->rowStream, $source, $follow, $this->row ] );

		ActivityHelper::addActivityCache( $this->row );

		$template		=	$this->template;
		$stream			=	$this->stream;
		$row			=	$this->row;
		$rowStream		=	$this->rowStream;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container', $this->template );

		echo $this->headers();
		$html			=	ob_get_clean();

		$this->ajax( $html, 'html', 'replace', 'container' );
	}

	/**
	 * @return bool
	 */
	public function authorizedUnfollow(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->myId && $this->row && $this->row->isPublished() && ( $this->row->getUserId() !== $this->myId ) && $this->rowStream->getParams()->getFollow() );
	}

	/**
	 * @return void
	 */
	public function unfollow(): void
	{
		global $_PLUGINS;

		$type			=	$this->input->getString( 'type', 'user' );
		$follow			=	new FollowTable();

		switch ( $type ) {
			case 'asset':
				$asset	=	(string) $this->row->getAsset();
				break;
			case 'user':
			default:
				$asset	=	'profile.' . $this->row->getUserId();
				break;
		}

		$follow->load( [ 'user_id' => $this->myId, 'asset' => $asset ] );

		if ( ! $follow->getId() ) {
			$this->ajax( CBTxt::T( 'You have not followed this post.' ), 'error' );
		}

		$source			=	$this->row->getSource();

		$_PLUGINS->trigger( 'activity_onBeforeUnfollowStreamActivity', [ $this->rowStream, $source, &$follow, $this->row ] );

		if ( $follow->getError() || ( ! $follow->canDelete() ) || ( ! $follow->delete() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_FOLLOW_FAILED_TO_DELETE', 'Post failed to unfollow! Error: [error]', [ '[error]' => $follow->getError() ] ), 'error' );
		}

		switch ( $type ) {
			case 'asset':
				$this->row->set( '_following', false );
				break;
			case 'user':
			default:
				$this->row->set( '_following_user', false );
				break;
		}

		$_PLUGINS->trigger( 'activity_onAfterUnfollowStreamActivity', [ $this->rowStream, $source, $follow, $this->row ] );

		ActivityHelper::addActivityCache( $this->row );

		$template		=	$this->template;
		$stream			=	$this->stream;
		$row			=	$this->row;
		$rowStream		=	$this->rowStream;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container', $this->template );

		echo $this->headers();
		$html			=	ob_get_clean();

		$this->ajax( $html, 'html', 'replace', 'container' );
	}

	/**
	 * @return bool
	 */
	public function authorizedBookmark(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->myId && $this->row && $this->row->isPublished() && ( $this->row->getUserId() !== $this->myId ) && $this->rowStream->getParams()->getBookmarks() );
