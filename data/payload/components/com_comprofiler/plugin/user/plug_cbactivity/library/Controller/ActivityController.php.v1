	/**
	 * @param array $options
	 * @return void
	 */
	public function show( array $options = [] ): void
	{
		global $_CB_framework;

		$rowId					=	( $options['id'] ?? null );

		if ( $rowId ) {
			$this->row			=	ActivityHelper::getActivity( $rowId );

			if ( ! $this->row->canAccess() ) {
				return;
			}
		}

		if ( $this->row ) {
			$this->showRow( $options );
			return;
		}

		$isRow					=	false;
		$isModal				=	( $this->isRaw && ( $this->show === 'modal' ) );
		$isInline				=	( $options['inline'] ?? false );
		$isEmbed				=	( ( $options['embed'] ?? false ) || ( $this->show === 'embed' ) );
		$isSimple				=	( ( $options['simple'] ?? false ) || $isEmbed );

		$filter					=	( $options['filter'] ?? 0 );
		$hashtag				=	( $options['hashtag'] ?? '' );
		$mentioned				=	( $options['mentioned'] ?? '' );
		$flair					=	( $options['flair'] ?? 0 );
		$search					=	( $options['search'] ?? '' );
		$post					=	( $options['post'] ?? '' );
		$date					=	( $options['date'] ?? '' );
		$dateRange				=	[];
		$page					=	'0';

		if ( \in_array( $this->input->getString( 'action', '' ), [ 'activity', 'activity.filter', 'activity.update', 'activity.show' ], true ) ) {
			if ( ( ! $this->show ) || ( $this->show === 'show' ) ) {
				$filter			=	$this->input->getInt( 'cookie/activity_filter_' . $this->stream->getId(), $filter );
			}

			$filter				=	$this->input->getInt( 'filter', $filter );
			$hashtag			=	( $this->stream->getParams()->getHashtags() && $this->stream->getParams()->canAccessSearchHashtag( $this->myId ) ? $this->input->getString( 'hashtag', $hashtag ) : $hashtag );
			$mentioned			=	( $this->stream->getParams()->getMentions() && $this->stream->getParams()->canAccessSearchMention( $this->myId ) ? $this->input->getString( 'mentioned', $mentioned ) : $mentioned );
			$flair				=	( $this->stream->getParams()->getFlair() && $this->stream->getParams()->canAccessSearchFlair( $this->myId ) ? $this->input->getInt( 'flair', $flair ) : $flair );
			$search				=	( $this->stream->getParams()->canAccessSearchPost( $this->myId ) ? $this->input->getString( 'search', $search ) : $search );
			$date				=	( $this->stream->getParams()->canAccessSearchDate( $this->myId ) ? $this->input->getString( 'date', $date ) : $date );
			$page				=	$this->input->getString( 'page', '0' );

			if ( $this->input->getBool( 'clear', false ) ) {
				$filter			=	0;
				$hashtag		=	'';
				$mentioned		=	'';
				$flair			=	0;
				$search			=	'';
				$date			=	'';
				$page			=	'0';
			}
		} elseif ( $this->input->getString( 'action', '' ) === 'activity.hashtag' ) {
			$hashtag			=	$this->input->getString( 'hashtag', $hashtag );
			$page				=	$this->input->getString( 'page', '0' );
		} elseif ( $this->input->getString( 'action', '' ) === 'activity.mentioned' ) {
			$mentioned			=	( $this->stream->getParams()->canAccessSearchMention( $this->myId ) ? $this->input->getString( 'mentioned', $mentioned ) : ( $mentioned ?: $this->myId ) );
			$page				=	$this->input->getString( 'page', '0' );
		} elseif ( $this->input->getString( 'action', '' ) === 'activity.flair' ) {
			$flair				=	( $this->stream->getParams()->canAccessSearchFlair( $this->myId ) ? $this->input->getInt( 'flair', $flair ) : $flair );
			$page				=	$this->input->getString( 'page', '0' );
		} elseif ( \in_array( $this->input->getString( 'action', '' ), [ 'activity.tagged', 'activity.likes', 'activity.liked', 'activity.commented', 'activity.bookmarked', 'activity.controversial', 'activity.reported', 'activity.pending' ], true ) ) {
			$page				=	$this->input->getString( 'page', '0' );
		}

		if ( \in_array( $this->input->getString( 'action', '' ), [ 'activity', 'activity.show' ], true ) ) {
			$post				=	$this->input->getString( 'post', '' );
		}

		if ( $hashtag ) {
			$hashtag			=	preg_replace( '/[^a-zA-Z0-9_]+/iu', '', $hashtag );
		}

		if ( $filter && ( ! \array_key_exists( $filter, $this->getFilters() ) ) ) {
			$filter				=	0;
		}

		if ( $flair && ( ! \array_key_exists( $flair, FlairHelper::getAll() ) ) ) {
			$flair				=	0;
		}

		if ( \in_array( $this->show, [ 'mentioned', 'hashtag', 'tagged', 'likes', 'liked', 'commented', 'bookmarked', 'controversial', 'reported', 'pending', 'embed', 'flair' ], true ) ) {
			$search				=	'';
			$date				=	'';

			if ( $this->show !== 'hashtag' ) {
				$hashtag		=	'';
			}

			if ( $this->show !== 'mentioned' ) {
				$mentioned		=	'';
			}

			if ( $this->show !== 'flair' ) {
				$flair			=	0;
			}
		} elseif ( $this->show === 'filter' ) {
			if ( ! $filter ) {
				if ( $this->input->has( 'cookie/activity_filter_' . $this->stream->getId() ) ) {
					setcookie( 'activity_filter_' . $this->stream->getId(), '', ( time() - 3600 ), '/', '', false, true );
				}
			} else {
				setcookie( 'activity_filter_' . $this->stream->getId(), $filter, ( time() + ( 3600 * 24 * 30 * 12 ) ), '/', '', false, true );
			}
		}

		if ( ! $this->stream->getParams()->getPaging() ) {
			$page				=	'0';
		}

		$isPage					=	( $this->isRaw && $page );
		$pageDir				=	( $this->show === 'update' ? '>' : '<' );
		$hasMore				=	false;
		$rows					=	$this->getRows( $page, $pageDir, $hasMore, $filter, $hashtag, $mentioned, $search, $flair, $date );

		if ( ( $page || \in_array( $this->show, [ 'update', 'modal' ], true ) ) && ( ! $rows ) ) {
			return;
		}

		PrefetchHelper::prefetchRows( $rows, true );

		$autoUpdate				=	$this->stream->getParams()->getAutoUpdate();
		$autoLoad				=	$this->stream->getParams()->getAutoLoad();

		if ( $isPage ) {
			$autoUpdate			=	false;
			$autoLoad			=	false;
		}

		if ( $this->show === 'hashtag' ) {
			$autoUpdate			=	false;
		}

		if ( ! $this->stream->getParams()->getPaging() ) {
			$hasMore			=	false;
			$autoLoad			=	false;
		}

		$form					=	null;

		if ( ( ! $isPage ) && ( ! \in_array( $this->show, [ 'update', 'filter', 'hashtag', 'mentioned', 'tagged', 'likes', 'liked', 'commented', 'bookmarked', 'modal', 'controversial', 'reported', 'pending', 'embed', 'flair' ], true ) ) && $this->stream->canCreate() ) {
			ob_start();
			$this->edit();
			$form				=	ob_get_clean();
		}

		$template				=	$this->template;
		$stream					=	$this->stream;

		if ( \in_array( $this->show, [ 'hashtag', 'mentioned', 'tagged', 'likes', 'liked', 'commented', 'bookmarked', 'modal', 'controversial', 'reported', 'pending', 'embed', 'flair' ], true ) ) {
			$streamFilters			=	[];
			$selectedFilter			=	null;
			$streamSearchPost		=	false;
			$streamSearchDate		=	false;
			$streamSearchHashtag	=	false;
			$streamSearchMention	=	false;
			$streamSearchFlair		=	false;
		} else {
			$streamFilters			=	$this->getFilters();

			// remove "All" from selection since we'll handle that with the clear button
			unset( $streamFilters[0] );

			$selectedFilter			=	null;

			if ( \count( $streamFilters ) <= 1 ) {
				$streamFilters		=	[];
			} elseif ( $filter ) {
				$selectedFilter		=	( $streamFilters[$filter] ?? null );
			}

			$streamSearchPost		=	$this->stream->getParams()->canAccessSearchPost( $this->myId );
			$streamSearchDate		=	$this->stream->getParams()->canAccessSearchDate( $this->myId );
			$streamSearchHashtag	=	( $this->stream->getParams()->getHashtags() && $this->stream->getParams()->canAccessSearchHashtag( $this->myId ) );
			$streamSearchMention	=	( $this->stream->getParams()->getMentions() && $this->stream->getParams()->canAccessSearchMention( $this->myId ) );
			$streamSearchFlair		=	( $this->stream->getParams()->getFlair() && $this->stream->getParams()->canAccessSearchFlair( $this->myId ) );
		}

		$pageUrl					=	'';
		$pageData					=	[];

		if ( $hasMore ) {
			$pageUrl						=	$_CB_framework->pluginClassUrl( 'cbactivity', false, [ 'action' => 'activity' . ( \in_array( $this->show, [ 'hashtag', 'mentioned', 'tagged', 'likes', 'liked', 'commented', 'bookmarked', 'modal', 'controversial', 'reported', 'pending', 'embed', 'flair' ], true ) ? '.' . $this->show : '' ), 'stream' => $this->stream->getId(), 'page' => ( $rows ? ArrayHelper::arrayLast( $rows )->getPage() : null ) ] );
			$pageData						=	[ 'action' => 'activity' . ( \in_array( $this->show, [ 'hashtag', 'mentioned', 'tagged', 'likes', 'liked', 'commented', 'bookmarked', 'modal', 'controversial', 'reported', 'pending', 'embed', 'flair' ], true ) ? '.' . $this->show : '' ), 'stream' => $this->stream->getId(), 'asset' => $this->stream->getAsset()->getEncoded() ];

			if ( ! \in_array( $this->show, [ 'mentioned', 'tagged', 'likes', 'liked', 'commented', 'bookmarked', 'modal', 'controversial', 'reported', 'pending', 'embed', 'flair' ], true ) ) {
				if ( ( ! \in_array( $this->show, [ 'hashtag', 'mentioned', 'flair' ], true ) ) && $selectedFilter ) {
					$pageData['filter']		=	$selectedFilter->getId();
				}

				if ( $hashtag ) {
					$pageData['hashtag']	=	$hashtag;
				}

				if ( $mentioned ) {
					$pageData['mentioned']	=	$mentioned;
				}

				if ( $flair ) {
					$pageData['flair']		=	$flair;
				}

				if ( $date ) {
					$pageData['date']		=	$date;
				}

				if ( $search ) {
					$pageData['search']		=	$search;
				}
			}
		}

		if ( ( ! $isPage ) && ( ! \in_array( $this->show, [ 'update', 'filter' ], true ) ) ) {
			if ( $date ) {
				if ( strpos( $date, ':' ) !== false ) {
					$dateRange				=	explode( ':', $date, 2 );
				} else {
					$dateRange				=	[ $date ];
				}
			}

			require HtmlHelper::getTemplate( 'activity/display', $this->template );
		} else {
			require HtmlHelper::getTemplate( 'activity/rows', $this->template );
		}

		if ( $post && $form ) {
			$_CB_framework->outputCbJQuery( "$( '.activityStream[data-cbactivity-stream=\"" . $this->stream->getId() . "\"] .activityContainerNew .streamInputMessage' ).triggerHandler( 'paste.cbactivity', [ " . json_encode( $post, JSON_HEX_TAG ) . " ] );" );
		}

		if ( $isPage || \in_array( $this->show, [ 'update', 'filter' ], true ) ) {
			echo $this->headers();
		}
	}

	/**
	 * @param array $options
	 * @return void
	 */
	private function showRow( array $options = [] ): void
	{
		if ( $this->show === 'embed' ) {
			if ( ! ( $options['embed'] ?? false ) ) {
				ShareHelper::renderEmbed( $this->row, $this->stream );
				return;
			}

			if ( ! $this->row ) {
				return;
			}
		}

		$isRow					=	true;
		$isModal				=	( $this->isRaw && ( $this->show === 'modal' ) );
		$isInline				=	( $options['inline'] ?? false );
		$isEmbed				=	( ( $options['embed'] ?? false ) || ( $this->show === 'embed' ) );
		$isSimple				=	( ( $options['simple'] ?? false ) || $isEmbed );
		$filter					=	0;
		$hashtag				=	'';
		$mentioned				=	'';
		$flair					=	0;
		$search					=	'';
		$date					=	'';
		$dateRange				=	[];
		$post					=	'';
		$page					=	'0';
		$isPage					=	false;
		$hasMore				=	false;
		$rows					=	[ $this->row->getId() => $this->row ];
		$autoUpdate				=	false;
		$autoLoad				=	false;
		$form					=	null;
		$template				=	$this->template;
		$stream					=	$this->stream;
		$streamFilters			=	[];
		$selectedFilter			=	null;
		$streamSearchPost		=	false;
		$streamSearchDate		=	false;
		$streamSearchHashtag	=	false;
		$streamSearchMention	=	false;
		$streamSearchFlair		=	false;
		$pageUrl				=	'';
		$pageData				=	[];

		require HtmlHelper::getTemplate( 'activity/display', $this->template );
	}

	/**
	 * @return bool
	 */
	public function authorizedTag(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->myId && $this->stream->getParams()->canAccessTags( $this->myId ) );
	}

	/**
	 * @return void
	 */
	public function tag(): void
	{
		global $_CB_database;

		$search					=	$this->input->getString( 'search', '' );

		switch ( $this->stream->getParams()->getTagsWho() ) {
			case 6: // Specific Usergroups
				$usergroups		=	$this->stream->getParams()->getTagsWhoUsergroups();

				if ( ! $usergroups ) {
					return;
				}

				$query			=	'SELECT j.' . $_CB_database->NameQuote( 'id' )
								.	"\n FROM " . $_CB_database->NameQuote( '#__users' ) . " AS j"
								.	"\n INNER JOIN " . $_CB_database->NameQuote( '#__user_usergroup_map' ) . " AS g"
								.	' ON g.' . $_CB_database->NameQuote( 'user_id' ) . ' = j.' . $_CB_database->NameQuote( 'id' )
								.	"\n WHERE g." . $_CB_database->NameQuote( 'group_id' ) . " IN " . $_CB_database->safeArrayOfIntegers( $usergroups )
								.	"\n AND j." . $_CB_database->NameQuote( 'block' ) . " = 0";

				if ( $search ) {
					$query		.=	"\n AND ( j." . $_CB_database->NameQuote( 'username' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false )
								.	" OR j." . $_CB_database->NameQuote( 'name' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false ) . " )";
				}
				break;
			case 5: // Likes Only
				$query			=	"SELECT j." . $_CB_database->NameQuote( 'id' )
								.	"\n FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_likes' ) . " AS f"
								.	"\n INNER JOIN " . $_CB_database->NameQuote( '#__users' ) . " AS j"
								.	" ON j." . $_CB_database->NameQuote( 'id' ) . " = f." . $_CB_database->NameQuote( 'user_id' )
								.	"\n WHERE f." . $_CB_database->NameQuote( 'asset' ) . " = " . $_CB_database->Quote( 'profile.' . $this->myId )
								.	"\n AND j." . $_CB_database->NameQuote( 'block' ) . " = 0"
								.	"\n AND ( j." . $_CB_database->NameQuote( 'username' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false )
								.	" OR j." . $_CB_database->NameQuote( 'name' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false ) . " )"
								.	"\n UNION \n"
								.	"SELECT SUBSTRING_INDEX( SUBSTRING_INDEX( f." . $_CB_database->NameQuote( 'asset' ) . ", '.', 2 ) , '.' , -1 )"
								.	"\n FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_likes' ) . " AS f"
								.	"\n INNER JOIN " . $_CB_database->NameQuote( '#__users' ) . " AS j"
								.	" ON j." . $_CB_database->NameQuote( 'id' ) . " = SUBSTRING_INDEX( SUBSTRING_INDEX( f." . $_CB_database->NameQuote( 'asset' ) . ", '.', 2 ) , '.' , -1 )"
								.	"\n WHERE f." . $_CB_database->NameQuote( 'user_id' ) . " = " . $this->myId
								.	"\n AND f." . $_CB_database->NameQuote( 'asset' ) . " LIKE " . $_CB_database->Quote( 'profile.%' )
								.	"\n AND j." . $_CB_database->NameQuote( 'block' ) . " = 0";

				if ( $search ) {
					$query		.=	"\n AND ( j." . $_CB_database->NameQuote( 'username' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false )
								.	" OR j." . $_CB_database->NameQuote( 'name' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false ) . " )";
				}
				break;
			case 4: // Follows Only
				$query			=	"SELECT j." . $_CB_database->NameQuote( 'id' )
								.	"\n FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_following' ) . " AS f"
								.	"\n INNER JOIN " . $_CB_database->NameQuote( '#__users' ) . " AS j"
								.	" ON j." . $_CB_database->NameQuote( 'id' ) . " = f." . $_CB_database->NameQuote( 'user_id' )
								.	"\n WHERE f." . $_CB_database->NameQuote( 'asset' ) . " = " . $_CB_database->Quote( 'profile.' . $this->myId )
								.	"\n AND j." . $_CB_database->NameQuote( 'block' ) . " = 0"
								.	"\n AND ( j." . $_CB_database->NameQuote( 'username' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false )
								.	" OR j." . $_CB_database->NameQuote( 'name' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false ) . " )"
								.	"\n UNION \n"
								.	"SELECT SUBSTRING_INDEX( SUBSTRING_INDEX( f." . $_CB_database->NameQuote( 'asset' ) . ", '.', 2 ) , '.' , -1 )"
								.	"\n FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_following' ) . " AS f"
								.	"\n INNER JOIN " . $_CB_database->NameQuote( '#__users' ) . " AS j"
								.	" ON j." . $_CB_database->NameQuote( 'id' ) . " = SUBSTRING_INDEX( SUBSTRING_INDEX( f." . $_CB_database->NameQuote( 'asset' ) . ", '.', 2 ) , '.' , -1 )"
								.	"\n WHERE f." . $_CB_database->NameQuote( 'user_id' ) . " = " . $this->myId
								.	"\n AND f." . $_CB_database->NameQuote( 'asset' ) . " LIKE " . $_CB_database->Quote( 'profile.%' )
								.	"\n AND j." . $_CB_database->NameQuote( 'block' ) . " = 0";

				if ( $search ) {
					$query		.=	"\n AND ( j." . $_CB_database->NameQuote( 'username' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false )
								.	" OR j." . $_CB_database->NameQuote( 'name' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false ) . " )";
				}
				break;
			case 3: // Moderators Only
				$moderatorViewAccessLevels		=	Application::CmsPermissions()->getGroupsOfViewAccessLevel( Application::Config()->getInt( 'moderator_viewaccesslevel', 3 ), true );

				if ( ! $moderatorViewAccessLevels ) {
					return;
				}

				$query			=	'SELECT j.' . $_CB_database->NameQuote( 'id' )
								.	"\n FROM " . $_CB_database->NameQuote( '#__users' ) . " AS j"
								.	"\n INNER JOIN " . $_CB_database->NameQuote( '#__user_usergroup_map' ) . " AS g"
								.	' ON g.' . $_CB_database->NameQuote( 'user_id' ) . ' = j.' . $_CB_database->NameQuote( 'id' )
								.	"\n WHERE g." . $_CB_database->NameQuote( 'group_id' ) . " IN " . $_CB_database->safeArrayOfIntegers( $moderatorViewAccessLevels )
								.	"\n AND j." . $_CB_database->NameQuote( 'block' ) . " = 0";

				if ( $search ) {
					$query		.=	"\n AND ( j." . $_CB_database->NameQuote( 'username' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false )
								.	" OR j." . $_CB_database->NameQuote( 'name' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false ) . " )";
				}
				break;
			case 2: // Connections Only
				$query			=	"SELECT j." . $_CB_database->NameQuote( 'id' )
								.	"\n FROM " . $_CB_database->NameQuote( '#__comprofiler_members' ) . " AS m"
								.	"\n INNER JOIN " . $_CB_database->NameQuote( '#__users' ) . " AS j"
								.	" ON j." . $_CB_database->NameQuote( 'id' ) . " = m." . $_CB_database->NameQuote( 'memberid' )
								.	"\n WHERE m." . $_CB_database->NameQuote( 'referenceid' ) . " = " . $this->myId
								.	"\n AND m." . $_CB_database->NameQuote( 'accepted' ) . " = 1"
								.	"\n AND j." . $_CB_database->NameQuote( 'block' ) . " = 0";

				if ( $search ) {
					$query		.=	"\n AND ( j." . $_CB_database->NameQuote( 'username' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false )
								.	" OR j." . $_CB_database->NameQuote( 'name' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false ) . " )";
				}
				break;
			case 1: // All Users
			default:
				$query			=	"SELECT " . $_CB_database->NameQuote( 'id' )
								.	"\n FROM " . $_CB_database->NameQuote( '#__users' )
								.	"\n WHERE " . $_CB_database->NameQuote( 'block' ) . " = 0";

				if ( $search ) {
					$query		.=	"\n AND ( " . $_CB_database->NameQuote( 'username' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false )
								.	" OR " . $_CB_database->NameQuote( 'name' ) . " LIKE " . $_CB_database->Quote( $_CB_database->getEscaped( $search, true ) . '%', false ) . " )";
				}
				break;
		}
		$_CB_database->setQuery( $query, 0, 20 );
		$connections			=	$_CB_database->loadResultArray();

		if ( $connections ) {
			CBuser::advanceNoticeOfUsersNeeded( $connections );
		}

		$tags					=	[];
		$tagsSuggestions		=	true;
		$searchFound			=	false;

		foreach ( $connections as $userId ) {
			$name				=	CBuser::getUserDataInstance( (int) $userId )->getFormattedName();

			if ( $name === $search ) {
				$searchFound	=	true;
			}

			$tag				=	new TagTable();

			$tag->setTag( (int) $userId );

			$tags[]				=	$tag;
		}

		if ( ! $searchFound ) {
			$tag				=	new TagTable();

			$tag->setTag( $search );

			array_unshift( $tags, $tag );
		}

		$template				=	$this->template;

		require HtmlHelper::getTemplate( 'tags/tags', $this->template );
	}

	/**
	 * @return bool
	 */
	public function authorizedTags(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->row && $this->row->getId() );
	}

	/**
	 * @return void
	 */
	public function tags(): void
	{
		global $_CB_framework, $_CB_database;

		$page			=	$this->input->getInt( 'page', 0 );
		$pageLimit		=	15;
		$where			=	[];

		if ( $page ) {
			$where[]	=	"( " . $_CB_database->NameQuote( 'id' ) . " < " . $page
						.	" AND " . $_CB_database->NameQuote( 'id' ) . " IS NOT NULL )";
		}

		$where[]		=	$_CB_database->NameQuote( 'activity_id' ) . " = " . $this->row->getId();

		$query			=	"SELECT *"
						.	"\n FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_tags' )
						.	( $where ? "\n WHERE " . implode( "\n AND ", $where ) : null )
						.	"\n ORDER BY " . $_CB_database->NameQuote( 'id' ) . " DESC";
		$_CB_database->setQuery( $query, 0, ( $pageLimit + 1 ) );
		$rows			=	$_CB_database->loadObjectList( 'id', TagTable::class, [ $_CB_database ] );

		PrefetchHelper::prefetchRows( $rows );

		$hasMore		=	( \count( $rows ) > $pageLimit );

		if ( $hasMore ) {
			$rows		=	\array_slice( $rows, 0, $pageLimit, true );
		}

		if ( ! $rows ) {
			return;
		}

		$template		=	$this->template;
		$activity		=	$this->row;

		if ( ! $page ) {
			$total		=	TagsHelper::getTotalByActivity( $this->row->getId() );
			$baseUrl	=	$_CB_framework->pluginClassUrl( 'cbactivity', true, [ 'action' => 'activity.tags', 'id' => $this->row->getId(), 'Itemid' => ActivityHelper::getStreamMenuId( $this->row->getStreamId() ) ], 'raw', 0, true );

			require HtmlHelper::getTemplate( 'tags/display', $this->template );
		} else {
			require HtmlHelper::getTemplate( 'tags/rows', $this->template );
		}
	}

	/**
	 * @return bool
	 */
	public function authorizedComments(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->row && $this->row->getId() && $this->row->getCommentsStreamId() && $this->row->getCommentStream() );
	}

	/**
	 * @return void
	 */
	public function comments(): void
	{
		echo $this->row->getCommentStream()->renderStream();
	}

	/**
	 * @return FilterEntity[]
	 */
	private function getFilters(): array
	{
		static $cache				=	[];

		if ( \array_key_exists( $this->stream->getId(), $cache ) ) {
			return $cache[$this->stream->getId()];
		}

		$filters					=	[];

		$defaultAssets				=	$this->stream->getParams()->getDefaultAssets();
		$defaultAssetsUsers			=	$this->stream->getParams()->getDefaultAssetsUsers();
		$defaultStreamIds			=	$this->stream->getParams()->getDefaultStreams();
		$defaultUsers				=	$this->stream->getParams()->getDefaultUsers();
		$defaultExcludeAssets		=	$this->stream->getParams()->getDefaultExcludeAssets();
		$defaultExcludeAssetsUsers	=	$this->stream->getParams()->getDefaultExcludeAssetsUsers();
		$defaultExcludeStreamIds	=	$this->stream->getParams()->getDefaultExcludeStreams();
		$defaultExcludeUsers		=	$this->stream->getParams()->getDefaultExcludeUsers();
		$streamData					=	$this->stream->getAsset()->getData( true );

		if ( $defaultAssets || $defaultStreamIds || $defaultUsers ) {
			$filters[0]				=	new FilterEntity( 0, CBTxt::T( 'FILTERS_ALL', 'All' ), $defaultAssets, $defaultAssetsUsers, $defaultStreamIds, $defaultUsers, $defaultExcludeAssets, $defaultExcludeAssetsUsers, $defaultExcludeStreamIds, $defaultExcludeUsers, $this->stream, $streamData );
		} else {
			// Fallback to core stream asset since no All defaults were supplied
			$filters[0]				=	new FilterEntity( 0, CBTxt::T( 'FILTERS_ALL', 'All' ), $this->stream->getAsset(), $defaultAssetsUsers, '', '', $defaultExcludeAssets, $defaultExcludeAssetsUsers, $defaultExcludeStreamIds, $defaultExcludeUsers, $this->stream, $streamData );
		}

		$i							=	1;

		foreach ( $this->stream->getFilters() as $filter ) {
			/** @var ParamsInterface $filter */
			$name					=	$filter->getString( 'filter', '' );
			$assets					=	$filter->getString( 'assets', '' );
			$assetsUsers			=	$filter->getBool( 'assets_users', true );
			$streamIds				=	$filter->getString( 'streams', '' );
			$users					=	$filter->getString( 'users', '' );
			$excludeAssets			=	$filter->getString( 'exclude_assets', '' );
			$excludeAssetsUsers		=	$filter->getBool( 'exclude_assets_users', false );
			$excludeStreamIds		=	$filter->getString( 'exclude_streams', '' );
			$excludeUsers			=	$filter->getString( 'exclude_users', '' );
			$access					=	$filter->getInt( 'access', 1 );

			if ( ( ! $name )
				 && ( ! $assets )
				 && ( ! $streamIds )
				 && ( ! $users )
				 && ( ! $excludeAssets )
				 && ( ! $excludeStreamIds )
				 && ( ! $excludeUsers )
			) {
				continue;
			}

			if ( ! $this->stream->getParams()->canAccess( $access ) ) {
				continue;
			}

			$filters[$i]			=	new FilterEntity( $i, CBTxt::T( $name ), $assets, $assetsUsers, $streamIds, $users, $excludeAssets, $excludeAssetsUsers, $excludeStreamIds, $excludeUsers, $this->stream, $streamData );

			$i++;
		}

		$cache[$this->stream->getId()]	=	$filters;

		return $filters;
	}

	/**
	 * @param string   $page
	 * @param string   $pageDir
	 * @param bool     $hasMore
	 * @param int      $filterId
	 * @param string   $hashtag
	 * @param string   $mentioned
	 * @param string   $search
	 * @param int      $flairId
	 * @param string   $date
	 * @param int      $loop
	 * @return ActivityTable[]
	 */
	private function getRows( string $page = '0', string $pageDir = '<', bool &$hasMore = false, int $filterId = 0, string $hashtag = '', string $mentioned = '', string $search = '', int $flairId = 0, string $date = '', int $loop = 0 ): array
	{
		global $_CB_framework, $_CB_database, $_PLUGINS;

		if ( $loop > 100 ) {
			// too much recursion so just give up
			// the stream probably should be configured better if this happens as too much server side aggregation is happening
			return [];
		}

		$pageLimit					=	$this->stream->getParams()->getPagingLimit();

		if ( $pageDir === '>' ) {
			$pageLimit				=	(int) ( $pageLimit / 2 );
		}

		$select						=	[ 'a.*' ];
		$join						=	[];
		$where						=	[];

		$unavailableStreams						=	[];

		if ( ! Application::MyUser()->isGlobalModerator() ) {
			$availableStreams					=	array_keys( ActivityHelper::getStreams( $this->myId ) );

			if ( ! $availableStreams ) {
				return [];
			}

			foreach ( array_keys( ActivityHelper::getStreams() ) as $knownStreamId ) {
				if ( \in_array( $knownStreamId, $availableStreams, true ) ) {
					continue;
				}

				$unavailableStreams[]			=	$knownStreamId;
			}
		}

		if ( \in_array( $this->show, [ 'hashtag', 'mentioned', 'tagged', 'likes', 'liked', 'commented', 'bookmarked', 'controversial', 'reported', 'pending', 'flair' ], true ) ) {
			$filterId							=	0;
			$selectedFilter						=	null;
		} else {
			$selectedFilter						=	( $this->getFilters()[$filterId] ?? null );
		}

		$streamAssets							=	( $selectedFilter ? $selectedFilter->getAssets() : [ $this->stream->getInitialAsset() => $this->stream->getAsset() ] );
		$streamAssetsUsers						=	( ( ! $selectedFilter ) || $selectedFilter->getAssetsUsers() );
		$streamStreamIds						=	( $selectedFilter ? $selectedFilter->getStreams() : [] );
		$streamUsers							=	( $selectedFilter ? $selectedFilter->getUsers() : [] );
		$streamExcludeAssets					=	( $selectedFilter ? $selectedFilter->getExcludeAssets() : [] );
		$streamExcludeAssetsUsers				=	( $selectedFilter && $selectedFilter->getExcludeAssetsUsers() );
		$streamExcludeStreamIds					=	( $selectedFilter ? $selectedFilter->getExcludeStreams() : [] );
		$streamExcludeUsers						=	( $selectedFilter ? $selectedFilter->getExcludeUsers() : [] );
		$streamModerator						=	$this->stream->canModerate();

		if ( \in_array( $this->show, [ 'hashtag', 'mentioned', 'tagged', 'likes', 'liked', 'commented', 'bookmarked', 'controversial', 'reported', 'pending', 'flair' ], true ) ) {
			$asset								=	'self.' . $this->show . 'only';
			$streamAssets						=	[ $asset => new AssetEntity( $asset ) ];
		} elseif ( $hashtag || $mentioned || $search || $flairId || $date ) {
			if ( $hashtag ) {
				$asset							=	'hashtagonly';
				$streamAssets[$asset]			=	new AssetEntity( $asset );
			}

			if ( $mentioned ) {
				$asset							=	'mentionedonly';
				$streamAssets[$asset]			=	new AssetEntity( $asset );
			}

			if ( $flairId ) {
				$asset							=	'flaironly';
				$streamAssets[$asset]			=	new AssetEntity( $asset );
			}

			if ( $date ) {
				$asset							=	'dateonly';
				$streamAssets[$asset]			=	new AssetEntity( $asset );
			}

			if ( $search ) {
				$asset							=	'searchonly';
				$streamAssets[$asset]			=	new AssetEntity( $asset );
			}
		}

		if ( $streamStreamIds ) {
			if ( $unavailableStreams ) {
				foreach ( $streamStreamIds as $k => $streamStreamId ) {
					if ( ! \in_array( $streamStreamId, $unavailableStreams, true ) ) {
						continue;
					}

					unset( $streamStreamIds[$k] );
				}

				if ( ! $streamStreamIds ) {
					return [];
				}
			}

			$where[]							=	"a." . $_CB_database->NameQuote( 'stream_id' ) . ( \count( $streamStreamIds ) > 1 ? " IN " . $_CB_database->safeArrayOfIntegers( $streamStreamIds ) : " = " . (int) $streamStreamIds[0] );
		} elseif ( $unavailableStreams ) {
			$streamExcludeStreamIds				=	\array_unique( \array_merge( $streamExcludeStreamIds, $unavailableStreams ) );
		}

		if ( $streamExcludeStreamIds ) {
			$where[]							=	"a." . $_CB_database->NameQuote( 'stream_id' ) . ( \count( $streamExcludeStreamIds ) > 1 ? " NOT IN " . $_CB_database->safeArrayOfIntegers( $streamExcludeStreamIds ) : " != " . (int) $streamExcludeStreamIds[0] );
		}

		if ( $streamUsers ) {
			$moderators							=	false;
			$connWhere							=	[];

			foreach ( $streamUsers as $k => $streamUser ) {
				if ( \is_numeric( $streamUser ) ) {
					continue;
				}

				$connUser						=	0;
				$connCheck						=	false;

				switch ( $streamUser ) {
					case 'asset_user':
						unset( $streamUsers[$k] );

						$streamUsers[$k]		=	$this->stream->getAsset()->getUser();
						continue 2;
					case 'moderators':
						unset( $streamUsers[$k] );

						$moderators				=	true;
						continue 2;
					case 'connections':
					case 'profile.connections':
						unset( $streamUsers[$k] );

						$connCheck				=	true;
						$connUser				=	$this->stream->getAsset()->getUser();
						break;
					case 'user':
						unset( $streamUsers[$k] );

						$streamUsers[$k]		=	( $_CB_framework->getDisplayedUser() ?: $this->myId );
						continue 2;
					case 'user.connections':
						unset( $streamUsers[$k] );

						$connCheck				=	true;
						$connUser				=	( $_CB_framework->getDisplayedUser() ?: $this->myId );
						break;
					case 'self':
						$streamUsers[$k]		=	$this->myId;
						continue 2;
					case 'self.connections':
						unset( $streamUsers[$k] );

						$connCheck				=	true;
						$connUser				=	$this->myId;
						break;
					case 'displayed':
						$streamUsers[$k]		=	$_CB_framework->getDisplayedUser();
						continue 2;
					case 'displayed.connections':
						unset( $streamUsers[$k] );

						$connCheck				=	true;
						$connUser				=	$_CB_framework->getDisplayedUser();
						break;
				}

				if ( $connCheck ) {
					$connections				=	UsersHelper::getConnections( $connUser );

					if ( $connections ) {
						if ( \count( $connections ) > 100 ) {
							$connWhere[]		=	"EXISTS ("
												.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_members' ) . " AS m"
												.		" WHERE m." . $_CB_database->NameQuote( 'accepted' ) . " = 1"
												.		" AND m." . $_CB_database->NameQuote( 'pending' ) . " = 0"
												.		" AND m." . $_CB_database->NameQuote( 'referenceid' ) . " = ". $connUser
												.		" AND m." . $_CB_database->NameQuote( 'memberid' ) . " = a." . $_CB_database->NameQuote( 'user_id' )
												.	")";
						} else {
							foreach( $connections as $connection ) {
								$streamUsers[]	=	$connection;
							}
						}
					}
				}

				// remove any unknown string types not handled above already
				unset( $streamUsers[$k] );
			}

			if ( $moderators ) {
				$streamUsers					=	array_merge( $streamUsers, UsersHelper::getModerators() );
			}

			$streamUsers						=	array_unique( array_filter( $streamUsers ) );
			$usersWhere							=	[];

			if ( $streamUsers ) {
				$usersWhere[]					=	"a." . $_CB_database->NameQuote( 'user_id' ) . ( \count( $streamUsers ) > 1 ? " IN " . $_CB_database->safeArrayOfIntegers( $streamUsers ) : " = " . (int) $streamUsers[0] );
			}

			if ( $connWhere ) {
				$usersWhere						=	array_merge( $usersWhere, $connWhere );
			}

			if ( $usersWhere ) {
				$where[]						=	( \count( $usersWhere ) > 1 ? "( " . implode( " OR ", $usersWhere ) . " )" : $usersWhere[0] );
			}
		}

		if ( $streamExcludeUsers ) {
			$where[]							=	"a." . $_CB_database->NameQuote( 'user_id' ) . ( \count( $streamExcludeUsers ) > 1 ? " NOT IN " . $_CB_database->safeArrayOfIntegers( $streamExcludeUsers ) : " != " . (int) $streamExcludeUsers[0] );
		}

		if ( $streamExcludeAssets ) {
			$excludeUserIds						=	[];
			$excludeAssets						=	[];

			foreach ( $streamExcludeAssets as $streamExcludeAsset ) {
				if ( ( strpos( $streamExcludeAsset, '%' ) !== false ) || ( strpos( $streamExcludeAsset, '_' ) !== false ) ) {
					$where[]					=	"a." . $_CB_database->NameQuote( 'asset' ) . " NOT LIKE " . $_CB_database->Quote( $streamExcludeAsset );
				} else {
					if ( $streamExcludeAssetsUsers && ( $streamExcludeAsset->getTarget() === 'profile' ) ) {
						$excludeUserIds[]		=	$streamExcludeAsset->getTargetId();
					}

					$excludeAssets[]			=	(string) $streamExcludeAsset;
				}
			}

			if ( $excludeUserIds ) {
				$excludeUserIds					=	array_unique( $excludeUserIds );

				$where[]						=	"a." . $_CB_database->NameQuote( 'user_id' ) . ( \count( $excludeUserIds ) > 1 ? " NOT IN " . $_CB_database->safeArrayOfIntegers( $excludeUserIds ) : " != " . (int) $excludeUserIds[0] );
			}

			if ( $excludeAssets ) {
				$where[]						=	"a." . $_CB_database->NameQuote( 'asset' ) . ( \count( $excludeAssets ) > 1 ? " NOT IN " . $_CB_database->safeArrayOfIntegers( $excludeAssets ) : " != " . (int) $excludeAssets[0] );
			}
		}

		if ( $streamAssets )  {
			$userIds								=	[];
			$assetsWhere							=	[];
			$assets									=	[];
			$isAnd									=	false;

			foreach ( $streamAssets as $asset ) {
				$isOnly								=	( $asset->getData()['is_only'] ?? false );

				if ( ( (string) $asset === 'all' ) || \in_array( $asset->getInitialAsset(), [ 'groupjiveonly', 'groupjive.my', 'groupjive.myonly', 'groupjive.joined', 'groupjive.joinedonly', 'groupjive.owned', 'groupjive.ownedonly', 'galleryonly' ], true ) ) {
					// Exclude All from normaly processing below, but also exclude any asset filtering that will be done in QueryHelper
					continue;
				}

				if ( strpos( $asset, 'connections' ) !== false ) {
					if ( ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						$profileId					=	$this->myId;
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'connections' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();
					}

					if ( $profileId ) {
						$connections				=	UsersHelper::getConnections( $profileId );

						if ( ! $connections ) {
							if ( $isOnly ) {
								return [];
							}
							continue;
						}

						if ( ( \count( $connections ) > 500 ) ) {
							// Only fallback to a subquery if we have to as subquery is slow
							$connectionsFilter		=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_members' ) . " AS m"
													.		" WHERE m." . $_CB_database->NameQuote( 'accepted' ) . " = 1"
													.		" AND m." . $_CB_database->NameQuote( 'pending' ) . " = 0"
													.		" AND m." . $_CB_database->NameQuote( 'referenceid' ) . " = ". $profileId
													.		" AND ( m." . $_CB_database->NameQuote( 'memberid' ) . " = a." . $_CB_database->NameQuote( 'user_id' )
													.		" OR CONCAT( 'profile.', m." . $_CB_database->NameQuote( 'memberid' ) . " ) = a." . $_CB_database->NameQuote( 'asset' ) . " )"
													.	")";

							if ( $isOnly ) {
								$where[]			=	$connectionsFilter;
							} else {
								$assetsWhere[]		=	$connectionsFilter;
							}
						} else {
							foreach( $connections as $connection ) {
								if ( $streamAssetsUsers ) {
									$userIds[]		=	$connection;
								}

								$assets[]			=	'profile.' . $connection;
							}

							if ( $isOnly ) {
								$isAnd				=	true;
							}
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'following' ) !== false ) {
					if ( ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						$profileId					=	$this->myId;
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'following' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();
					}

					if ( $profileId ) {
						$followed					=	FollowingHelper::getFollowed( $profileId );

						if ( ! $followed ) {
							if ( $isOnly ) {
								return [];
							}
							continue;
						}

						if ( ( \count( $followed ) > 500 ) ) {
							// Only fallback to a subquery if we have to as subquery is slow
							$followingFilter		=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_following' ) . " AS following"
													.		" WHERE following." . $_CB_database->NameQuote( 'user_id' ) . " = ". $profileId
													.		" AND following." . $_CB_database->NameQuote( 'asset' ) . " IN ( a." . $_CB_database->NameQuote( 'asset' ) . ", CONCAT( 'profile.', a." . $_CB_database->NameQuote( 'user_id' ) . " ) )"
													.	")";

							if ( $isOnly ) {
								$where[]			=	$followingFilter;
							} else {
								$assetsWhere[]		=	$followingFilter;
							}
						} else {
							foreach( $followed as $follow ) {
								if ( $streamAssetsUsers && ( $follow->getTarget() === 'profile' ) ) {
									$userIds[]		=	$asset->getTargetId();
								}

								$assets[]			=	(string) $follow;
							}

							if ( $isOnly ) {
								$isAnd				=	true;
							}
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'likes' ) !== false ) {
					if ( ( $this->show === 'likes' ) || ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						$profileId					=	$this->myId;
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'likes' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();
					}

					if ( $profileId ) {
						$liked						=	LikesHelper::getLikedAssets( $profileId );

						if ( ! $liked ) {
							if ( $isOnly ) {
								return [];
							}
							continue;
						}

						if ( ( \count( $liked ) > 500 ) ) {
							// Only fallback to a subquery if we have to as subquery is slow
							$likesFilter			=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_likes' ) . " AS likes"
													.		" WHERE likes." . $_CB_database->NameQuote( 'user_id' ) . " = ". $profileId
													.		" AND likes." . $_CB_database->NameQuote( 'asset' ) . " IN ( a." . $_CB_database->NameQuote( 'asset' ) . ", CONCAT( 'activity.', a." . $_CB_database->NameQuote( 'id' ) . " ) )"
													.	")";

							if ( $isOnly ) {
								$where[]			=	$likesFilter;
							} else {
								$assetsWhere[]		=	$likesFilter;
							}
						} else {
							foreach( $liked as $like ) {
								if ( $streamAssetsUsers && ( $like->getTarget() === 'profile' ) ) {
									$userIds[]		=	$asset->getTargetId();
								}

								$assets[]			=	(string) $like;
							}

							if ( $isOnly ) {
								$isAnd				=	true;
							}
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'liked' ) !== false ) {
					if ( ( $this->show === 'liked' ) || ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						$profileId					=	$this->myId;
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'liked' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();
					}

					if ( $profileId ) {
						if ( ! LikesHelper::hasActivityLikes( $profileId ) ) {
							if ( $isOnly ) {
								return [];
							}
							continue;
						}

						$likedFilter				=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_liked' ) . " AS liked"
													.		" WHERE liked." . $_CB_database->NameQuote( 'user_id' ) . " = " . $profileId
													.		" AND liked." . $_CB_database->NameQuote( 'activity_id' ) . " = a." . $_CB_database->NameQuote( 'id' )
													.	")";

						if ( $isOnly ) {
							$where[]				=	$likedFilter;
						} else {
							$assetsWhere[]			=	$likedFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'commented' ) !== false ) {
					if ( ( $this->show === 'commented' ) || ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						$profileId					=	$this->myId;
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'commented' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();
					}

					if ( $profileId ) {
						if ( ! CommentsHelper::hasActivityComments( $profileId ) ) {
							if ( $isOnly ) {
								return [];
							}
							continue;
						}

						$commentedFilter			=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_commented' ) . " AS commented"
													.		" WHERE commented." . $_CB_database->NameQuote( 'user_id' ) . " = " . $profileId
													.		" AND commented." . $_CB_database->NameQuote( 'activity_id' ) . " = a." . $_CB_database->NameQuote( 'id' )
													.	")";

						if ( $isOnly ) {
							$where[]				=	$commentedFilter;
						} else {
							$assetsWhere[]			=	$commentedFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'bookmarked' ) !== false ) {
					if ( ( $this->show === 'bookmarked' ) || ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						$profileId					=	$this->myId;
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'bookmarked' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();
					}

					if ( $profileId ) {
						if ( ! BookmarkHelper::hasBookmarks( $profileId ) ) {
							if ( $isOnly ) {
								return [];
							}
							continue;
						}

						$bookmarkFilter				=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_bookmarked' ) . " AS bookmarked"
													.		" WHERE bookmarked." . $_CB_database->NameQuote( 'user_id' ) . " = " . $profileId
													.		" AND bookmarked." . $_CB_database->NameQuote( 'activity_id' ) . " = a." . $_CB_database->NameQuote( 'id' )
													.	")";

						if ( $isOnly ) {
							$where[]				=	$bookmarkFilter;
						} else {
							$assetsWhere[]			=	$bookmarkFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'mentioned' ) !== false ) {
					if ( $mentioned || ( $this->show === 'mentioned' ) || ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						$profileId					=	0;

						if ( ! $mentioned ) {
							$profileId				=	$this->myId;
						} elseif ( is_numeric( $mentioned ) ) {
							$profileId				=	(int) $mentioned;
						} elseif ( \is_string( $mentioned ) ) {
							$mentionedUser			=	new UserTable();

							$mentionedUser->loadByUsername( trim( $mentioned ) );

							$profileId				=	$mentionedUser->getInt( 'id', 0 );

							if ( ! $profileId ) {
								$mentionedUser->load( [ 'name' => trim( $mentioned ) ] );

								$profileId			=	$mentionedUser->getInt( 'id', 0 );
							}
						}
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'mentioned' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();
					}

					if ( $profileId ) {
						if ( ! MentionsHelper::hasMentions( $profileId ) ) {
							if ( $isOnly ) {
								return [];
							}
							continue;
						}

						$mentionedFilter			=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_mentions' ) . " AS mentioned"
													.		" WHERE mentioned." . $_CB_database->NameQuote( 'user_id' ) . " = " . $profileId
													.		" AND mentioned." . $_CB_database->NameQuote( 'activity_id' ) . " = a." . $_CB_database->NameQuote( 'id' )
													.	")";

						if ( $isOnly ) {
							$where[]				=	$mentionedFilter;
						} else {
							$assetsWhere[]			=	$mentionedFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'tagged' ) !== false ) {
					if ( ( $this->show === 'tagged' ) || ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						$profileId					=	$this->myId;
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'tagged' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();
					}

					if ( $profileId ) {
						if ( ! TagsHelper::hasTags( $profileId ) ) {
							if ( $isOnly ) {
								return [];
							}
							continue;
						}

						$taggedFilter				=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_tags' ) . " AS tagged"
													.		" WHERE tagged." . $_CB_database->NameQuote( 'activity_id' ) . " = a." . $_CB_database->NameQuote( 'id' )
													.		" AND tagged." . $_CB_database->NameQuote( 'tag' ) . " = " . $profileId
													.	")";

						if ( $isOnly ) {
							$where[]				=	$taggedFilter;
						} else {
							$assetsWhere[]			=	$taggedFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'hashtag' ) !== false ) {
					if ( $hashtag ) {
						$hashtagFilter				=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_hashtags' ) . " AS hashtag"
													.		" WHERE hashtag." . $_CB_database->NameQuote( 'hashtag' ) . " = " . $_CB_database->Quote( $hashtag )
													.		" AND hashtag." . $_CB_database->NameQuote( 'activity_id' ) . " = a." . $_CB_database->NameQuote( 'id' )
													.	")";

						if ( $isOnly ) {
							$where[]				=	$hashtagFilter;
						} else {
							$assetsWhere[]			=	$hashtagFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'flair' ) !== false ) {
					if ( ( $asset->getTarget() === 'flair' ) && $asset->getTargetId() ) {
						$flairId					=	$asset->getTargetId();
					}

					if ( $flairId ) {
						if ( ! \array_key_exists( $flairId, FlairHelper::getByProfile( $this->myId ) ) ) {
							if ( $isOnly ) {
								return [];
							}
							continue;
						}

						$flairFilter				=	"EXISTS ("
													.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_flairs' ) . " AS flair"
													.		" WHERE flair." . $_CB_database->NameQuote( 'flair_id' ) . " = " . $_CB_database->Quote( $flairId )
													.		" AND flair." . $_CB_database->NameQuote( 'activity_id' ) . " = a." . $_CB_database->NameQuote( 'id' )
													.	")";

						if ( $isOnly ) {
							$where[]				=	$flairFilter;
						} else {
							$assetsWhere[]			=	$flairFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'controversial' ) !== false ) {
					$controversial					=	GlobalParams::getReportingControversial();

					if ( $controversial ) {
						$controversialFilter		=	"a." . $_CB_database->NameQuote( 'reports' ) . " >= " . $controversial;

						if ( $isOnly ) {
							$where[]				=	$controversialFilter;
						} else {
							$assetsWhere[]			=	$controversialFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'reported' ) !== false ) {
					if ( ( $this->show === 'reported' ) || ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						if ( $streamModerator ) {
							$profileId				=	false;
						} else {
							$profileId				=	$this->myId;
						}
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'reported' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();

						if ( \in_array( $asset->getInitialAsset(), [ 'reported', 'reportedonly' ], true ) && $streamModerator ) {
							$profileId				=	false;
						}
					}

					if ( $profileId !== false ) {
						if ( ( ! $profileId ) || ( ( ! $streamModerator ) && ( $profileId !== $this->myId ) ) ) {
							return [];
						}

						$where[]					=	"a." . $_CB_database->NameQuote( 'user_id' ) . " = " . $profileId;
					}

					$where['published']				=	"a." . $_CB_database->NameQuote( 'published' ) . " = 3";
				} elseif ( strpos( $asset, 'pending' ) !== false ) {
					if ( ( $this->show === 'pending' ) || ( $asset->getTarget() === 'stream' ) || ( $asset->getTarget() === 'all' ) ) {
						if ( $streamModerator ) {
							$profileId				=	false;
						} else {
							$profileId				=	$this->myId;
						}
					} elseif ( ( $asset->getTarget() === 'profile' ) && ( $asset->getVerb() === 'pending' ) ) {
						$profileId					=	$asset->getTargetId();
					} else {
						$profileId					=	$asset->getUser();
					}

					if ( $profileId !== false ) {
						if ( ( ! $profileId ) || ( ( ! $streamModerator ) && ( $profileId !== $this->myId ) ) ) {
							return [];
						}

						$where[]					=	"a." . $_CB_database->NameQuote( 'user_id' ) . " = " . $profileId;
					}

					$where['published']				=	"a." . $_CB_database->NameQuote( 'published' ) . " = 2";
				} elseif ( strpos( $asset, 'search' ) !== false ) {
					if ( $search ) {
						$searchFilter				=	"a." . $_CB_database->NameQuote( 'message' ) . " LIKE " . $_CB_database->Quote( '%' . $_CB_database->getEscaped( $search, true ) . '%', false );

						if ( $isOnly ) {
							$where[]				=	$searchFilter;
						} else {
							$assetsWhere[]			=	$searchFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( strpos( $asset, 'date' ) !== false ) {
					if ( $date ) {
						if ( strpos( $date, ':' ) !== false ) {
							[ $dateFrom, $dateTo ]	=	explode( ':', $date, 2 );

							if ( $dateFrom && $dateTo ) {
								$dateFilter			=	"a." . $_CB_database->NameQuote( 'date' ) . " BETWEEN " . $_CB_database->Quote( $dateFrom ) . " AND " . $_CB_database->Quote( $dateTo );
							} elseif ( $dateFrom ) {
								$dateFilter			=	"a." . $_CB_database->NameQuote( 'date' ) . " >= " . $_CB_database->Quote( $dateFrom );
							} elseif ( $dateTo ) {
								$dateFilter			=	"a." . $_CB_database->NameQuote( 'date' ) . " <= " . $_CB_database->Quote( $dateTo );
							} else {
								return [];
							}
						} else {
							$dateFilter				=	"a." . $_CB_database->NameQuote( 'date' ) . " >= " . $_CB_database->Quote( $date );
						}

						if ( $isOnly ) {
							$where[]				=	$dateFilter;
						} else {
							$assetsWhere[]			=	$dateFilter;
						}
					} elseif ( $isOnly ) {
						return [];
					}
				} elseif ( ( strpos( $asset, '%' ) !== false ) || ( strpos( $asset, '_' ) !== false ) ) {
					$assetsWhere[]					=	"a." . $_CB_database->NameQuote( 'asset' ) . " LIKE " . $_CB_database->Quote( (string) $asset );

					if ( $isOnly ) {
						$isAnd						=	true;
					}
				} else {
					if ( $streamAssetsUsers && ( $asset->getTarget() === 'profile' ) ) {
						$userIds[]					=	$asset->getTargetId();
					}

					$assets[]						=	(string) $asset;

					if ( $isOnly ) {
						$isAnd						=	true;
					}
				}

				if ( \in_array( false, $_PLUGINS->trigger( 'activity_onQueryActivityFilter', [ $this->stream, $selectedFilter, $asset, &$userIds, &$assets, &$assetsWhere, $hashtag, $mentioned, $search, $flairId, $loop ] ), true ) ) {
					return [];
				}
			}

			if ( $userIds ) {
				$userIds							=	array_unique( $userIds );

				$assetsWhere[]						=	"a." . $_CB_database->NameQuote( 'user_id' ) . ( \count( $userIds ) > 1 ? " IN " . $_CB_database->safeArrayOfIntegers( $userIds ) : " = " . (int) $userIds[0] );
			}

			if ( $assets ) {
				$assets								=	array_unique( $assets );

				$assetsWhere[]						=	"a." . $_CB_database->NameQuote( 'asset' ) . ( \count( $assets ) > 1 ? " IN " . $_CB_database->safeArrayOfStrings( $assets ) : " = " . $_CB_database->Quote( $assets[0] ) );
			}

			if ( $assetsWhere ) {
				$assetsWhere						=	array_unique( $assetsWhere );

				$where[]							=	( \count( $assetsWhere ) > 1 ? "( " . implode( ( $isAnd ? " AND " : " OR " ), $assetsWhere ) . " )" : $assetsWhere[0] );
			}
		}

		if ( $this->myId && GlobalParams::getHidden() ) {
			if ( GlobalParams::getHiddenActivity() ) {
				$where[]		=	"NOT EXISTS ("
								.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_hidden' ) . " AS h1"
								.		" WHERE h1." . $_CB_database->NameQuote( 'user_id' ) . " = " . $this->myId
								.		" AND h1." . $_CB_database->NameQuote( 'type' ) . " = " . $_CB_database->Quote( 'activity' )
								.		" AND ( h1." . $_CB_database->NameQuote( 'object' ) . " = a." . $_CB_database->NameQuote( 'id' )
								.		" OR a." . $_CB_database->NameQuote( 'asset' ) . " LIKE CONCAT_WS( '.', 'activity', h1." . $_CB_database->NameQuote( 'object' ) . ", '%' ) )"
								.	")";
			}

			if ( GlobalParams::getHiddenUser() ) {
				$where[]		=	"NOT EXISTS ("
								.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_hidden' ) . " AS h2"
								.		" WHERE h2." . $_CB_database->NameQuote( 'user_id' ) . " = " . $this->myId
								.		" AND h2." . $_CB_database->NameQuote( 'type' ) . " = " . $_CB_database->Quote( 'activity.user' )
								.		" AND h2." . $_CB_database->NameQuote( 'object' ) . " = a." . $_CB_database->NameQuote( 'user_id' )
								.	")";
			}

			if ( GlobalParams::getHiddenSimilar() ) {
				$where[]		=	"NOT EXISTS ("
								.		"SELECT 1 FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_hidden' ) . " AS h3"
								.		" WHERE h3." . $_CB_database->NameQuote( 'user_id' ) . " = " . $this->myId
								.		" AND h3." . $_CB_database->NameQuote( 'type' ) . " = " . $_CB_database->Quote( 'activity.asset' )
								.		" AND h3." . $_CB_database->NameQuote( 'asset' ) . " = a." . $_CB_database->NameQuote( 'asset' )
								.	")";
			}
		}

		if ( ( ! \array_key_exists( 'access', $where ) ) && ( ! Application::MyUser()->isGlobalModerator() ) && ( ! $this->stream->getParams()->getPreviewAssets() ) ) {
			$where[]			=	"a." . $_CB_database->NameQuote( 'access' ) . " IN " . $_CB_database->safeArrayOfIntegers( Application::MyUser()->getAuthorisedViewLevels() );
		}

		if ( ( ! \array_key_exists( 'published', $where ) ) && ( ! Application::MyUser()->isGlobalModerator() ) ) {
			if ( $this->myId ) {
				$where[]		=	"( a." . $_CB_database->NameQuote( 'published' ) . ( $streamModerator ? " >= 1" :  " = 1" )
								.	" OR a." . $_CB_database->NameQuote( 'user_id' ) . " = " . $this->myId . " )";
			} else {
				$where[]		=	"a." . $_CB_database->NameQuote( 'published' ) . ( $streamModerator ? " >= 1" :  " = 1" );
			}
		}

		QueryHelper::filterActivity( $select, $join, $where, ( $this->getFilters()[$filterId] ?? null ), $this->stream );

		if ( $page ) {
			$where[]			=	"( a." . $_CB_database->NameQuote( 'page' ) . " " . $pageDir . " " . $_CB_database->Quote( $page )
								.	" AND a." . $_CB_database->NameQuote( 'page' ) . " IS NOT NULL )";
		}

		$_PLUGINS->trigger( 'activity_onQueryActivity', [ $this->stream, &$select, &$join, &$where ] );

		$query					=	"SELECT " . implode( ", ", $select )
								.	" FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity' ) . " AS a"
								.	( $join ? "\n " . implode( "\n ", $join ) : null )
								.	( $where ? "\n WHERE " . implode( "\n AND ", $where ) : null )
								.	" ORDER BY a." . $_CB_database->NameQuote( 'page' ) . " DESC";
		$_CB_database->setQuery( $query, 0, ( $pageDir === '>' ? $pageLimit : ( $pageLimit + 1 ) ) );
		$rows					=	$_CB_database->loadObjectList( 'id', ActivityTable::class, [ $_CB_database ] );

		if ( $pageDir === '>' ) {
			$hasMore			=	false;
		} else {
			$hasMore			=	( \count( $rows ) > $pageLimit );

			if ( $hasMore ) {
				$rows			=	\array_slice( $rows, 0, $pageLimit, true );
			}
		}

		PrefetchHelper::prefetchRows( $rows );

		$rowsCount				=	\count( $rows );
		$lastPage				=	( $rows ? ( $pageDir === '>' ? ArrayHelper::arrayFirst( $rows )->getPage() : ArrayHelper::arrayLast( $rows )->getPage() ) : null );

		$_PLUGINS->trigger( 'activity_onLoadActivity', [ $this->stream, &$rows ] );

		QueryHelper::verifyAccess( $rows, $this->stream );
		QueryHelper::group( $rows, $this->stream );

		$newCount				=	\count( $rows );

		if ( $rowsCount && $lastPage && ( $newCount < round( $rowsCount / 1.5 ) ) ) {
			$nextPage			=	( $pageLimit - $newCount );

			if ( $nextPage <= 0 ) {
				$nextPage		=	1;
			}

			$rows				+=	\array_slice( $this->getRows( $lastPage, $pageDir, $hasMore, $filterId, $hashtag, $mentioned, $search, $flairId, $date, ( $loop + 1 ) ), 0, $nextPage, true );
		}

		return $rows;
	}
}