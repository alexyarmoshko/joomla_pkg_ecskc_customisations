			$flair->setFlairId( $flairId );

			$_PLUGINS->trigger( 'activity_onBeforeCreateActivityStreamFlair', [ $this->rowStream, $this->row, &$flair ] );

			if ( $flair->getError() || ( ! $flair->check() ) || ( ! $flair->store() ) ) {
				continue;
			}

			$_PLUGINS->trigger( 'activity_onAfterCreateActivityStreamFlair', [ $this->rowStream, $this->row, $flair ] );
		}
