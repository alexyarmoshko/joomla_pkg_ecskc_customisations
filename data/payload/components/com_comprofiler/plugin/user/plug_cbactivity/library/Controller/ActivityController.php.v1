use CBLib\Registry\ParamsInterface;
use CBuser;

\defined( '_JEXEC' ) or die;

\defined( 'CBLIB' ) or die;

class ActivityController extends BaseController
{
	/** @var null|ActivityStreamTable */
	protected ?StreamTable $stream		=	null;
	/** @var null|ActivityTable */
	protected ?Table $row				=	null;
	/** @var null|ActivityStreamTable */
	protected ?StreamTable $rowStream	=	null;

	/**
	 * @param null|Input       $input
	 * @param bool             $raw
	 * @param null|StreamTable $stream
	 * @param null|AssetEntity $asset
	 * @param null|Table       $row
	 */
	public function __construct( ?Input $input = null, bool $raw = false, ?StreamTable $stream = null, ?AssetEntity $asset = null, ?Table $row = null )
	{
		parent::__construct( $input, $raw, $stream, $asset, $row );

		if ( ( ! $this->stream )
			 && $input
			 && \in_array( $this->input->getString( 'action', '' ), [ 'activity.reported', 'activity.pending', 'activity.liked', 'activity.bookmarked', 'activity.tagged', 'activity.mentioned', 'activity.flair' ], true )
			 && $this->myId
		) {
			// These views don't technically require a stream, but we'll use one anyway for it's various parameters and it's missing so default to Recent Activity
			$this->stream	=	ActivityHelper::getStream( 1 );
		}
	}

	/**
	 * @param string $view
	 * @return bool
	 */
	public function authorized( string $view = '' ): bool
	{
		return (bool) $this->stream;
	}

	/**
	 * @return bool
	 */
	public function authorizedEdit(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->row && $this->rowStream->canEditActivity( $this->row ) );
	}

	/**
	 * @return void
	 */
	public function edit(): void
	{
		global $_CB_database, $_CB_framework;

		if ( ! $this->row ) {
			$stream							=	$this->stream;

			if ( preg_match( '/^activity_stream\.(\d+)$/', $this->stream->getInitialAsset(), $matches ) ) {
				$inheritStream				=	ActivityHelper::getStream( (int) ( $matches[1] ?? 0 ) );

				if ( $inheritStream ) {
					$stream					=	$inheritStream;
				}
			}

			$this->row						=	new ActivityTable();

			$this->row->setStreamId( $stream->getId() );
			$this->row->setAsset( (string) $stream->getAsset() );
			$this->row->setUserId( $this->myId );

			$this->rowStream				=	$stream;
		}

		$canModerate						=	Application::MyUser()->isGlobalModerator();
		$form								=	[	'id'				=>	\hash( 'adler32', \uniqid( $this->stream->getId() . '.' . $this->row->getId() . '.', true ) ),
													'url'				=>	$_CB_framework->pluginClassUrl( 'cbactivity', true, [ 'action' => 'activity.save', 'id' => $this->row->getId(), 'stream' => $this->rowStream->getId(), 'asset' => $this->rowStream->getAsset()->getEncoded(), 'Itemid' => ActivityHelper::getStreamMenuId( $this->rowStream->getId() ) ], 'raw', 0, true ),
													'menu'				=>	[],
													'inputs'			=>	[],
													'buttons'			=>	[],
													'actions'			=>	[],
													'features'			=>	[],
													'message_required'	=>	$this->rowStream->getParams()->getRequireMessage(),
													'message_limit'		=>	( $canModerate ? 0 : $this->rowStream->getParams()->getMessageLimit() ),
													'new'				=>	( ! $this->row->getId() ),
													'collapsed'			=>	( ( ! $this->row->getId() ) && ( $this->rowStream->getParams()->getCollapsed() ) ),
													'captcha'			=>	'',
													'captcha_invisible'	=>	false,
													'reactions'			=>	'',
													'stickers'			=>	'',
													'emotes'			=>	'',
													'themes'			=>	'',
													'themes_classes'	=>	'',
													'themes_styles'		=>	'',
													'links_preview'		=>	'',
													'no_comments'		=>	$this->rowStream->getParams()->canAccessCommentsToggle( $this->row->getUserId() ),
													'system'			=>	$this->rowStream->getParams()->canAccessCreateSystem( $this->row->getUserId() ),
												];

		if ( $this->rowStream->getParams()->canAccessCaptcha( $this->myId, ( ! $this->row->getId() ) ) ) {
			$captcha						=	CaptchaHelper::getCaptcha( $this->row, $this->rowStream );

			if ( $captcha ) {
				$form['captcha']			=	$captcha->getCaptcha();
				$form['captcha_invisible']	=	\in_array( $captcha->getMode(), [ 'honeypot', 'recaptcha_score', 'recaptcha_invisible', 'honeypot', 'timer' ], true );
				$form['features'][]			=	'captcha';
			}
		}

		if ( $this->rowStream->getParams()->canAccessMentions( $this->row->getUserId() ) ) {
			$form['features'][]				=	'mentions';
			$form['inputs'][]				=	MentionsHelper::renderButton( [ 'stream_type' => 'activity', 'stream' => $this->rowStream->getId(), 'asset' => $this->rowStream->getAsset()->getEncoded() ] );
		}

		if ( $this->rowStream->getParams()->canAccessHashtags( $this->row->getUserId() ) ) {
			$form['features'][]				=	'hashtags';
			$form['inputs'][]				=	HashtagsHelper::renderButton( [ 'stream_type' => 'activity', 'stream' => $this->rowStream->getId(), 'asset' => $this->rowStream->getAsset()->getEncoded() ] );
		}

		if ( $this->rowStream->getParams()->canAccessReactions( $this->row->getUserId() ) ) {
			$form['features'][]				=	'reactions';
			$form['reactions']				=	ReactionsHelper::renderButton( [ 'stream_type' => 'activity', 'stream' => $this->rowStream->getId(), 'asset' => $this->rowStream->getAsset()->getEncoded() ] );
		}

		if ( $this->rowStream->getParams()->canAccessStickers( $this->row->getUserId() ) && StickersHelper::getByProfile( $this->row->getUserId() ) ) {
			$form['features'][]				=	'stickers';
			$form['stickers']				=	StickersHelper::renderButton( $this->row->getUserId(), [ 'stream_type' => 'activity', 'stream' => $this->rowStream->getId(), 'asset' => $this->rowStream->getAsset()->getEncoded() ] );
		}

		if ( $this->rowStream->getParams()->canAccessEmotes( $this->row->getUserId() ) ) {
			$form['features'][]				=	'emotes';
			$form['emotes']					=	EmojiHelper::renderButton( [ 'stream_type' => 'activity', 'stream' => $this->rowStream->getId(), 'asset' => $this->rowStream->getAsset()->getEncoded() ] );
		}

		if ( $this->rowStream->getParams()->canAccessLinks( $this->row->getUserId() ) ) {
			$form['features'][]				=	'links';

			if ( $this->rowStream->getParams()->canAccessLinksPreviews( $this->row->getUserId() ) ) {
				$form['features'][]			=	'links_previews';

				if ( $this->row->getId() && $this->row->getLink() ) {
					$form['links_preview']	=	LinksHelper::renderPreview( $this->row->getParams()->getLinkURL(), $this->row->getLink(), $this->row->getParams()->getLinkThumbnail(), $this->row->getParams()->getLinkDetails() );
				}
			}
		}

		$template							=	$this->template;
		$stream								=	$this->stream;
		$row								=	$this->row;
		$rowStream							=	$this->rowStream;
		$actions							=	( $this->rowStream->getParams()->canAccessActions( $this->row->getUserId() ) ? ActionsHelper::getActionsByProfile( $this->row->getUserId() ) : [] );

		if ( $actions ) {
			$action							=	$this->row->getAction();
			$actionRequired					=	$this->rowStream->getParams()->getRequireAction();

			if ( $actionRequired && ( ! $action ) ) {
				$action						=	new ActionEntity( $this->row, ArrayHelper::arrayFirst( $actions ), '' );
			}

			if ( ( ! $actionRequired ) || ( \count( $actions ) > 1 ) ) {
				ob_start();
				require HtmlHelper::getTemplate( 'actions/button', $this->template );
				$form['menu'][]				=	ob_get_clean();
			}

			ob_start();
			require HtmlHelper::getTemplate( 'actions/form', $this->template );
			$form['inputs'][]				=	ob_get_clean();
		}

		$locations							=	( $this->rowStream->getParams()->canAccessLocations( $this->row->getUserId() ) ? LocationsHelper::getActionsByProfile( $this->row->getUserId() ) : [] );

		if ( $locations ) {
			$location						=	$this->row->getLocation();
			$locationRequired				=	$this->rowStream->getParams()->getRequireLocation();

			if ( $locationRequired && ( ! $location ) ) {
				$location					=	new LocationEntity( $this->row, ArrayHelper::arrayFirst( $locations ), '', '', '', '', 0, 0 );
			}

			if ( ( ! $locationRequired ) || ( \count( $locations ) > 1 ) ) {
				ob_start();
				require HtmlHelper::getTemplate( 'locations/button', $this->template );
				$form['menu'][]				=	ob_get_clean();
			}

			$locationSource					=	GlobalParams::getLocationsSource();
			$locationDefault				=	GlobalParams::getLocationsDefault();
			$locationKey					=	( $locationSource === 'google' ? GlobalParams::getLocationsGoogle() : '' );
			$locationSearch					=	GlobalParams::getLocationsSearch();

			ob_start();
			require HtmlHelper::getTemplate( 'locations/form', $this->template );
			$form['inputs'][]				=	ob_get_clean();
		}

		$themes								=	( $this->rowStream->getParams()->canAccessThemes( $this->row->getUserId() ) ? ThemesHelper::getByProfile( $this->row->getUserId() ) : [] );

		if ( $themes ) {
			$themeRequired					=	$this->rowStream->getParams()->getRequireTheme();
			$selectedTheme					=	$this->row->getTheme();

			if ( $selectedTheme ) {
				$form['themes_classes']		=	' ' . trim( 'streamMessageTheme ' . htmlspecialchars( $selectedTheme->getBackgroundClass() ) );
				$form['themes_styles']		=	$selectedTheme->getBackgroundStyle();
			}

			$themeId						=	$this->row->getParams()->getTheme();

			ob_start();
			require HtmlHelper::getTemplate( 'themes/button', $this->template );
			$form['themes']					=	ob_get_clean();
		}

		if ( $this->rowStream->getParams()->canAccessGallery( $this->row->getUserId() ) ) {
			$gallery						=	GalleryHelper::getMediaGallery( $this->row, $this->rowStream );

			if ( $gallery ) {
				$galleryHasMedia			=	( $row->getParams()->getGalleryMedia() || ( ( ! $this->row->getId() ) && $gallery->hasHold() ) );
				$galleryRequired			=	$this->rowStream->getParams()->getRequireGallery();

				if ( ! $galleryRequired ) {
					ob_start();
					require HtmlHelper::getTemplate( 'gallery/button', $this->template );
					$form['menu'][]			=	ob_get_clean();
				}

				ob_start();
				require HtmlHelper::getTemplate( 'gallery/form', $this->template );
				$form['inputs'][]			=	ob_get_clean();
			}
		}

		if ( $this->rowStream->getParams()->canAccessPrivacy( $this->row->getUserId() ) ) {
			$privacy						=	PrivacyHelper::getPrivacy( $this->row, $this->rowStream );

			if ( $privacy ) {
				$form['buttons'][]			=	$privacy->privacy( 'edit' );
			}
		}

		$flair								=	( $this->rowStream->getParams()->canAccessFlair( $this->row->getUserId() ) ? FlairHelper::getByProfile( $this->row->getUserId() ) : [] );

		if ( $flair ) {
			$flairRequired					=	$this->rowStream->getParams()->getRequireFlair();
			$selectedFlair					=	$this->row->getFlair();

			foreach ( $flair as $k => $f ) {
				if ( ! $f->getHidden() ) {
					continue;
				}

				if ( \array_key_exists( $k, $selectedFlair ) ) {
					continue;
				}

				unset( $flair[$k] );
			}

			ob_start();
			require HtmlHelper::getTemplate( 'flair/button', $this->template );
			$form['buttons'][]				=	ob_get_clean();
		}

		if ( $this->rowStream->getParams()->canAccessPolls( $this->row->getUserId() ) ) {
			$poll							=	$this->row->getParams()->getPoll();
			$pollLocked						=	( $poll && PollsHelper::getVotesByActivity( $this->row->getId() ) );
			$pollDays						=	$this->row->getParams()->getPollDays();
			$pollHours						=	$this->row->getParams()->getPollHours();
			$pollMinutes					=	$this->row->getParams()->getPollMinutes();
			$pollRequired					=	$this->rowStream->getParams()->getRequirePoll();

			if ( $pollRequired && ( ! $poll ) ) {
				$poll						=	[ '', '', '' ];
			}

			if ( ( ! $pollDays ) && ( ! $pollHours ) && ( ! $pollMinutes ) ) {
				$pollDays					=	1;
			}

			if ( ! $pollRequired ) {
				ob_start();
				require HtmlHelper::getTemplate( 'polls/button', $this->template );
				$form['menu'][]				=	ob_get_clean();
			}

			$pollLimit						=	( $canModerate ? 0 : $this->rowStream->getParams()->getPollsLimit() );

			ob_start();
			require HtmlHelper::getTemplate( 'polls/form', $this->template );
			$form['inputs'][]				=	ob_get_clean();
		}

		if ( $this->rowStream->getParams()->canAccessTags( $this->row->getUserId() ) ) {
			$tags							=	[];
			$tagsSuggestions				=	false;
			$tagsRequired					=	$this->rowStream->getParams()->getRequireTag();

			if ( $this->row->getId() ) {
				$query						=	"SELECT *"
											.	"\n FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_tags' )
											.	"\n WHERE " . $_CB_database->NameQuote( 'activity_id' ) . " = " . $this->row->getId()
											.	"\n ORDER BY " . $_CB_database->NameQuote( 'id' ) . " ASC";
				$_CB_database->setQuery( $query );
				$tags						=	$_CB_database->loadObjectList( 'id', TagTable::class, [ $_CB_database ] );

				PrefetchHelper::prefetchRows( $tags );
			}

			if ( ! $tagsRequired ) {
				ob_start();
				require HtmlHelper::getTemplate( 'tags/button', $this->template );
				$form['menu'][]				=	ob_get_clean();
			}

			ob_start();
			require HtmlHelper::getTemplate( 'tags/form', $this->template );
			$form['inputs'][]				=	ob_get_clean();
		}

		if ( $this->row->getId() ) {
			$form['integrations']			=	HtmlHelper::getIntegrations( 'onDisplayActivityStreamEdit', [ $this->rowStream, &$this->row, &$form ] );
		} else {
			$form['integrations']			=	HtmlHelper::getIntegrations( 'onDisplayActivityStreamNew', [ $this->rowStream, &$this->row, &$form ] );
		}

		if ( $this->row->getId() ) {
			ob_start();
			require HtmlHelper::getTemplate( 'activity/edit', $this->template );

			echo $this->headers();
			$html				=	ob_get_clean();

			$this->ajax( $html );
		} else {
			require HtmlHelper::getTemplate( 'activity/new', $this->template );
		}
	}

	/**
	 * @return bool
	 */
	public function authorizedCaptcha(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->rowStream->getParams()->canAccessCaptcha( $this->myId, ( ! $this->row ) ) );
	}

	/**
	 * @return void
	 */
	public function captcha(): void
	{
		$captcha	=	CaptchaHelper::getCaptcha( $this->row, $this->rowStream );

		if ( ! $captcha ) {
			return;
		}

		ob_start();
		echo $captcha->getCaptcha();
		echo $this->headers();
		$html		=	ob_get_clean();

		$this->ajax( $html, 'html', 'replace_into', 'self' );
	}

	/**
	 * @return bool
	 */
	public function authorizedSave(): bool
	{
		return ( $this->isRaw && $this->csrf() && ( ! $this->row ? $this->stream : $this->rowStream )->canCreateOrEditActivity( $this->row ) );
	}

	/**
	 * @return void
	 */
	public function save(): void
	{
		global $_CB_database, $_CB_framework, $_PLUGINS;

		$isNew								=	false;
		$isNowPending						=	false;

		if ( ! $this->row ) {
			$stream							=	$this->stream;

			if ( preg_match( '/^activity_stream\.(\d+)$/', $this->stream->getInitialAsset(), $matches ) ) {
				$inheritStream				=	ActivityHelper::getStream( (int) ( $matches[1] ?? 0 ) );

				if ( $inheritStream ) {
					$stream					=	$inheritStream;
				}
			}

			$this->row						=	new ActivityTable();

			$this->row->setStreamId( $stream->getId() );
			$this->row->setAccess( ( $stream->getAsset()->getAccess() ?: $stream->getAccess() ) );
			$this->row->setAsset( (string) $stream->getAsset() );
			$this->row->setUserId( $this->myId );

			$this->rowStream				=	$stream;

			if ( $this->rowStream->getParams()->getCreateApproval() && ( ! $this->rowStream->canModerate( $this->row ) ) ) {
				$this->row->setPublished( 2 );
			} else {
				$this->row->setPublished( 1 );
			}

			$isNew							=	true;
		} elseif ( $this->rowStream->getParams()->getEditApproval() && ( ! $this->row->isPending() ) && ( ! $this->rowStream->canModerate( $this->row ) ) ) {
			$this->row->setPublished( 2 );

			$isNowPending					=	true;
		}

		if ( $this->rowStream->getParams()->canAccessCaptcha( $this->myId, ( ! $this->row->getId() ) ) ) {
			$captcha						=	CaptchaHelper::getCaptcha( $this->row, $this->rowStream );

			if ( ( ! $captcha ) || ( ! $captcha->load() ) || ( ! $captcha->validateValue() ) ) {
				$this->ajax( ( $captcha->getError() ?: CBTxt::T( 'Invalid Captcha Code' ) ), 'error' );
			}
		}

		$canModerate						=	Application::MyUser()->isGlobalModerator();

		if ( $this->rowStream->getParams()->canAccessCreateSystem( $this->row->getUserId() ) && $this->input->getBool( 'system', false ) ) {
			$systemUser						=	GlobalParams::getSystemUser();

			if ( $systemUser ) {
				$this->row->setUserId( $systemUser );
			}

			$this->row->setSystem( 1 );
		} else {
			$this->row->setSystem( 0 );
		}

		$messageLimit						=	( $canModerate ? 0 : $this->rowStream->getParams()->getMessageLimit() );

		if ( $this->row->getSystem() ) {
			$message						=	trim( $this->input->getHtml( 'message', $this->row->getMessage() ) );
		} else {
			$message						=	trim( $this->input->getString( 'message', $this->row->getMessage() ) );
		}

		// Remove duplicate spaces:
		$message							=	preg_replace( '/ {2,}/', ' ', $message );
		// Remove duplicate tabs:
		$message							=	preg_replace( '/\t{2,}/i', "\t", $message );
		// Remove duplicate linebreaks:
		$message							=	preg_replace( '/((?:\r\n|\r|\n){2})(?:\r\n|\r|\n)*/i', '$1', $message );
		// Replace non-breaking spaces:
		$message							=	str_replace( html_entity_decode( '&nbsp;', ENT_COMPAT, 'UTF-8' ), ' ', $message );

		if ( $messageLimit && ( $this->rowStream->getParser( $message )->asLength() > $messageLimit ) ) {
			$this->ajax( CBTxt::T( 'Post is too long.' ), 'warning' );
		}

		$this->row->setMessage( $message );

		if ( $this->rowStream->getParams()->canAccessCommentsToggle( $this->row->getUserId() ) ) {
			$this->row->getParams()->setComments( ( ! $this->input->getInt( 'no_comments', false ) ) );
		} else {
			$this->row->getParams()->setComments( true );
		}

		if ( $this->rowStream->getParams()->canAccessThemes( $this->row->getUserId() ) ) {
			$themeId						=	$this->input->getInt( 'theme', 0 );

			if ( ! \array_key_exists( $themeId, ThemesHelper::getByProfile( $this->row->getUserId() ) ) ) {
				$themeId					=	0;
			}

			$this->row->getParams()->setTheme( $themeId );

			if ( $this->rowStream->getParams()->getRequireTheme() && ( ! $themeId ) ) {
				$this->ajax( CBTxt::T( 'Please select a theme for your post.' ), 'warning' );
			}
		} else {
			$this->row->getParams()->setTheme( 0 );
		}

		if ( $this->rowStream->getParams()->canAccessActions( $this->row->getUserId() ) ) {
			$actions						=	ActionsHelper::getActionsByProfile( $this->row->getUserId() );
			$actionId						=	$this->input->getInt( 'actions.id', 0 );

			if ( ! \array_key_exists( $actionId, $actions ) ) {
				$actionId					=	0;
			}

			$actionMessage					=	( $actionId ? trim( cbutf8_substr( $this->input->getString( 'actions.message', '' ), 0, 200 ) ) : '' );
			// Remove linebreaks:
			$actionMessage					=	str_replace( [ "\n", "\r\n" ], ' ', $actionMessage );
			// Remove duplicate spaces:
			$actionMessage					=	preg_replace( '/ {2,}/', ' ', $actionMessage );
			// Remove duplicate tabs:
			$actionMessage					=	preg_replace( '/\t{2,}/i', "\t", $actionMessage );

			$actionId						=	( $actionMessage ? $actionId : 0 );

			if ( $actionId ) {
				$this->row->setRequiresMessage( false );
			}

			$this->row->getParams()->setActionId( $actionId );
			$this->row->getParams()->setActionMessage( ( $actionId ? $actionMessage : '' ) );

			if ( $this->rowStream->getParams()->getRequireAction() && ( ! $actionId ) ) {
				$this->ajax( CBTxt::T( 'Please provide what you are doing or how you are feeling.' ), 'warning' );
			}
		} else {
			$this->row->getParams()->setActionId( 0 );
			$this->row->getParams()->setActionMessage( '' );
		}

		if ( $this->rowStream->getParams()->canAccessLocations( $this->row->getUserId() ) ) {
			$locationId						=	$this->input->getInt( 'locations.id', 0 );

			if ( ! \array_key_exists( $locationId, LocationsHelper::getActionsByProfile( $this->row->getUserId() ) ) ) {
				$locationId					=	0;
			}

			$locationReference				=	( $locationId ? $this->input->getString( 'locations.ref', '' ) : '' );
			$locationPlace					=	( $locationId ? trim( cbutf8_substr( $this->input->getString( 'locations.place', '' ), 0, 200 ) ) : '' );
			$locationAddress				=	( $locationId ? trim( cbutf8_substr( $this->input->getString( 'locations.address', '' ), 0, 200 ) ) : '' );
			$locationLatitude				=	( $locationId ? $this->input->getFloat( 'locations.lat', 0 ) : 0 );
			$locationLongitude				=	( $locationId ? $this->input->getFloat( 'locations.lng', 0 ) : 0 );

			$locationId						=	( $locationAddress || ( $locationLatitude && $locationLongitude ) ? $locationId : 0 );

			if ( $locationId ) {
				$this->row->setRequiresMessage( false );
			}

			if ( ( $locationAddress !== $this->row->getParams()->getLocationAddress() )
				 || ( $locationLatitude !== $this->row->getParams()->getLocationLatitude() )
				 || ( $locationLongitude !== $this->row->getParams()->getLocationLongitude() )
				 || ( ! $this->row->getParams()->getLocationSource() )
			) {
				$this->row->getParams()->setLocationSource( ( $locationId ? GlobalParams::getLocationsSource() : '' ) );
			}

			if ( $locationId && $locationAddress && ( ! $locationLatitude ) && ( ! $locationLongitude ) && preg_match( '/^(-?\d+(?:\.\d+)?),\s*(-?\d+(?:\.\d+)?)$/', $locationAddress, $locationMatch ) ) {
				// We have an address, but no latitude and longitude so lets see if address IS a latitude and longitude
				$locationLatitude			=	(float) $locationMatch[1];
				$locationLongitude			=	(float) $locationMatch[2];
			}

			$this->row->getParams()->setLocationId( $locationId );
			$this->row->getParams()->setLocationReference( ( $locationId ? $locationReference : '' ) );
			$this->row->getParams()->setLocationPlace( ( $locationId ? $locationPlace : '' ) );
			$this->row->getParams()->setLocationAddress( ( $locationId ? $locationAddress : '' ) );
			$this->row->getParams()->setLocationLatitude( ( $locationId ? $locationLatitude : 0 ) );
			$this->row->getParams()->setLocationLongitude( ( $locationId ? $locationLongitude : 0 ) );

			if ( $this->rowStream->getParams()->getRequireLocation() && ( ! $locationId ) ) {
				$this->ajax( CBTxt::T( 'Please provide a location for your post.' ), 'warning' );
			}
		} else {
			$this->row->getParams()->setLocationSource( '' );
			$this->row->getParams()->setLocationId( 0 );
			$this->row->getParams()->setLocationReference( '' );
			$this->row->getParams()->setLocationPlace( '' );
			$this->row->getParams()->setLocationAddress( '' );
			$this->row->getParams()->setLocationLatitude( 0 );
			$this->row->getParams()->setLocationLongitude( 0 );
		}

		if ( GlobalParams::getInlineLinksReplace() ) {
			$message						=	Parser::replaceInlineLinks( $message, 'shortcode' );

			$this->row->setMessage( $message );
		}

		if ( $this->rowStream->getParams()->canAccessLinks( $this->row->getUserId() ) ) {
			if ( $this->rowStream->getParams()->canAccessLinksPreviews( $this->row->getUserId() ) ) {
				$linkUrl					=	$this->input->getString( 'link.url', '' );

				$this->row->getParams()->setLinkURL( $linkUrl );
				$this->row->getParams()->setLinkMedia( ( LinksHelper::getMedia( $linkUrl ) ?: [] ) );

				if ( ( ( $this->row->getParams()->getLinkMedia()['type'] ?? '' ) === 'url' ) && ( $this->row->getParams()->getLinkMedia()['thumbnail'] ?? '' ) ) {
					$this->row->getParams()->setLinkThumbnail( $this->input->getBool( 'link.thumbnail', false ) );
					$this->row->getParams()->setLinkDetails( $this->input->getBool( 'link.details', false ) );
				} else {
					$this->row->getParams()->setLinkThumbnail( true );
					$this->row->getParams()->setLinkDetails( true );
				}

				if ( $this->rowStream->getParams()->getRequireLink() && ( ! $linkUrl ) ) {
					$this->ajax( CBTxt::T( 'Please provide a link in your post.' ), 'warning' );
				}
			} else {
				$this->row->getParams()->setLinkURL( '' );
				$this->row->getParams()->setLinkMedia( [] );
				$this->row->getParams()->setLinkThumbnail( false );
				$this->row->getParams()->setLinkDetails( false );
			}
		} else {
			$message						=	preg_replace( ( Parser::getRegexp()['link'] ?? '' ), '', $message );

			$this->row->setMessage( $message );
		}

		if ( $this->rowStream->getParams()->canAccessFlair( $this->row->getUserId() ) ) {
			$flair							=	$this->input->getRaw( 'flair', [] );

			if ( ! \is_array( $flair ) ) {
				$flair						=	explode( '|*|', $flair );
			}

			$currentFlair					=	$this->row->getParams()->getFlair();
			$availableFlair					=	FlairHelper::getByProfile( $this->row->getUserId() );
			$selectedExclusive				=	[];
			$selectedFlair					=	[];

			foreach ( $flair as $v ) {
				if ( ! \array_key_exists( $v, $availableFlair ) ) {
					continue;
				}

				if ( $availableFlair[$v]->getHidden() && ( ! \in_array( $v, $currentFlair, true ) ) ) {
					continue;
				}

				if ( $availableFlair[$v]->getCategory()->getExclusive() ) {
					if ( \in_array( $availableFlair[$v]->getCategoryId(), $selectedExclusive, true ) ) {
						continue;
					}

					$selectedExclusive[]	=	$availableFlair[$v]->getCategoryId();
				}

				$selectedFlair[]			=	(int) $v;
			}

			$this->row->getParams()->setFlair( $selectedFlair );

			if ( $this->rowStream->getParams()->getRequireFlair() && ( ! $selectedFlair ) ) {
				$this->ajax( CBTxt::T( 'Please select flair for your post.' ), 'warning' );
			}
		} else {
			$this->row->getParams()->setFlair( [] );
		}

		$hadPoll							=	false;

		if ( $this->rowStream->getParams()->canAccessPolls( $this->row->getUserId() ) ) {
			$poll							=	$this->input->getRaw( 'poll', [] );

			if ( ! \is_array( $poll ) ) {
				$poll						=	explode( '|*|', $poll );
			}

			if ( ( ! $this->row->getParams()->getPoll() ) || ( ! PollsHelper::getVotesByActivity( $this->row->getId() ) ) ) {
				if ( $poll ) {
					foreach ( $poll as $i => $v ) {
						$poll[$i]			=	trim( cbutf8_substr( Get::clean( $v, GetterInterface::STRING ), 0, 200 ) );
					}

					$poll					=	\array_slice( \array_filter( $poll ), 0, $this->rowStream->getParams()->getPollsLimit() );

					if ( \count( $poll ) < 2 ) {
						$this->ajax( CBTxt::T( 'Please provide at least 2 poll options.' ), 'warning' );
					}
				} elseif ( $this->row->getParams()->getPoll() ) {
					$hadPoll				=	true;
				}

				$pollDays					=	( $poll ? max( 0, min( 6, $this->input->getInt( 'poll_days', 1 ) ) ) : 1 );
				$pollHours					=	( $poll ? max( 0, min( 23, $this->input->getInt( 'poll_hours', 0 ) ) ) : 0 );
				$pollMinutes				=	( $poll ? max( 0, min( 59, $this->input->getInt( 'poll_minutes', 0 ) ) ) : 0 );

				if ( ( ! $pollDays ) && ( ! $pollHours ) && ( ! $pollMinutes ) ) {
					$pollDays				=	1;
				}

				$this->row->getParams()->setPoll( $poll );
				$this->row->getParams()->setPollDays( $pollDays );
				$this->row->getParams()->setPollHours( $pollHours );
				$this->row->getParams()->setPollMinutes( $pollMinutes );
			} elseif ( ! $this->input->getBool( 'poll_locked', true ) ) {
				if ( $this->row->getParams()->getPoll() ) {
					$hadPoll				=	true;
				}

				$this->row->getParams()->setPoll( [] );
				$this->row->getParams()->setPollDays( 1 );
				$this->row->getParams()->setPollHours( 0 );
				$this->row->getParams()->setPollMinutes( 0 );
			}

			if ( $this->rowStream->getParams()->getRequirePoll() && ( ! $this->row->getParams()->getPoll() ) ) {
				$this->ajax( CBTxt::T( 'Please include a poll in your post.' ), 'warning' );
			}
		} else {
			if ( $this->row->getParams()->getPoll() ) {
				$hadPoll					=	true;
			}

			$this->row->getParams()->setPoll( [] );
			$this->row->getParams()->setPollDays( 1 );
			$this->row->getParams()->setPollHours( 0 );
			$this->row->getParams()->setPollMinutes( 0 );
		}

		if ( $this->rowStream->getParams()->canAccessGallery( $this->row->getUserId() ) ) {
			$gallery						=	GalleryHelper::getMediaGallery( $this->row, $this->rowStream );

			if ( $gallery ) {
				$galleryShared				=	$this->input->getRaw( 'cbgallery.shared', $this->row->getParams()->getGalleryMedia() );
				$galleryMedia				=	[];

				if ( $galleryShared ) {
					cbArrayToInts( $galleryShared );

					foreach ( GalleryHelper::getItems( $galleryShared ) as $sharedMedia ) {
						if ( ! $gallery->canDeleteMedia( $sharedMedia ) ) {
							continue;
						}

						$galleryMedia[]		=	$sharedMedia->getId();
					}
				}

				if ( $galleryMedia ) {
					$this->row->setRequiresMessage( false );
				}

				$this->row->getParams()->setGalleryMedia( $galleryMedia );

				if ( $this->rowStream->getParams()->getRequireGallery() && ( ! $galleryMedia ) ) {
					$this->ajax( CBTxt::T( 'Please include media in your post.' ), 'warning' );
				}
			}
		} else {
			$this->row->getParams()->setGalleryMedia( [] );
		}

		$old								=	new ActivityTable();
		$source								=	$this->row->getSource();

		if ( $this->rowStream->getParams()->canAccessStickers( $this->row->getUserId() ) ) {
			$stickers						=	$this->rowStream->getParser( $message )->getStickers();

			foreach ( $stickers as $sticker ) {
				if ( \array_key_exists( $sticker, StickersHelper::getByProfile( $this->row->getUserId() ) ) ) {
					continue;
				}

				$message					=	str_replace( '(sticker:' . $sticker . ')', '', $message );

				$this->row->setMessage( $message );
			}

			if ( $this->rowStream->getParams()->getRequireSticker() && ( ! $stickers ) ) {
				$this->ajax( CBTxt::T( 'Please provide a sticker in your post.' ), 'warning' );
			}
		} else {
			$message						=	preg_replace( ( Parser::getRegexp()['sticker'] ?? '' ), '', $message );

			$this->row->setMessage( $message );
		}

		if ( GlobalParams::getInlineMentionsReplace() ) {
			$message						=	Parser::replaceInlineMentions( $message, 'shortcode' );

			$this->row->setMessage( $message );
		}

		if ( $this->rowStream->getParams()->canAccessMentions( $this->row->getUserId() ) ) {
			$mentions						=	$this->rowStream->getParser( $message )->getMentions();

			foreach ( $mentions as $mention ) {
				switch ( GlobalParams::getMentionsWho() ) {
					case 5: // Likes Only
						if ( LikesHelper::isUserLiked( $mention, $this->row->getUserId() ) ) {
							continue 2;
						}
						break;
					case 4: // Follows Only
						if ( FollowingHelper::isUserFollowed( $mention, $this->row->getUserId() ) ) {
							continue 2;
						}
						break;
					case 3: // Moderators Only
						if ( \in_array( $mention, UsersHelper::getModerators(), true ) ) {
							continue 2;
						}
						break;
					case 2: // Connections Only
						if ( \in_array( $mention, UsersHelper::getConnections( $this->row->getUserId() ), true ) ) {
							continue 2;
						}
						break;
					case 1: // All Users
					default:
						if ( CBuser::getUserDataInstance( $mention )->getInt( 'id', 0 ) ) {
							continue 2;
						}
						break;
				}

				$message					=	str_replace( '(mention:' . $mention . ')', '', $message );

				$this->row->setMessage( $message );
			}

			if ( $this->rowStream->getParams()->getRequireMention() && ( ! $mentions ) ) {
				$this->ajax( CBTxt::T( 'Please provide a @mention in your post.' ), 'warning' );
			}
		} else {
			$message						=	preg_replace( ( Parser::getRegexp()['mention'] ?? '' ), '', $message );

			$this->row->setMessage( $message );
		}

		if ( GlobalParams::getInlineHashtagsReplace() ) {
			$message						=	Parser::replaceInlineHashtags( $message, 'shortcode' );

			$this->row->setMessage( $message );
		}

		if ( $this->rowStream->getParams()->canAccessHashtags( $this->row->getUserId() ) ) {
			if ( $this->rowStream->getParams()->getRequireHashtag() && ( ! $this->rowStream->getParser( $message )->getHashtags() ) ) {
				$this->ajax( CBTxt::T( 'Please provide a #hashtag in your post.' ), 'warning' );
			}
		} else {
			$message						=	preg_replace( ( Parser::getRegexp()['hashtag'] ?? '' ), '', $message );

			$this->row->setMessage( $message );
		}

		if ( $this->rowStream->getParams()->canAccessTags( $this->row->getUserId() )
			 && $this->rowStream->getParams()->getRequireTag()
			 && ( ! $this->input->getRaw( 'tags', [] ) )
		) {
			$this->ajax( CBTxt::T( 'Please tag someone in your post.' ), 'warning' );
		}

		if ( $this->rowStream->getParams()->canAccessReactions( $this->row->getUserId() )
			 && $this->rowStream->getParams()->getRequireAction()
			 && ( ! $this->rowStream->getParser( $message )->getReactions() )
		) {
			$this->ajax( CBTxt::T( 'Please provide a reaction GIF in your post.' ), 'warning' );
		}

		if ( $this->row->getRequiresMessage() && (
			 $this->row->getAsset()->isObjectOf( 'activity' )
			 || $this->row->getAsset()->isObjectOf( 'comment' )
			 || $this->row->getAsset()->isObjectOf( 'blog' )
			 || $this->row->getAsset()->isObjectOf( 'article' )
			 || $this->row->getAsset()->isObjectOf( 'page' )
			 || $this->row->getAsset()->isObjectOf( 'kunena' )
			 || $this->row->getAsset()->isObjectOriginOf( 'gallery' )
			 || $this->row->getAsset()->isObjectFirstOf( [ 'event', 'file', 'video', 'photo', 'wall' ], 'groupjive' )
		) ) {
			// bypass requiring a message if we're a known type that already includes attached content
			$this->row->setRequiresMessage( false );
		}

		if ( ! $isNew ) {
			$old->load( $this->row->getId() );

			if ( Application::Date( $this->row->getDate(), 'UTC' )->modify( '+5 MINUTES' )->getTimestamp() < Application::Date( 'now', 'UTC' )->getTimestamp() ) {
				$this->row->setDateModified( Application::Database()->getUtcDateTime() );
			}

			$_PLUGINS->trigger( 'activity_onBeforeUpdateStreamActivity', [ $this->rowStream, $source, &$this->row, $old ] );
		} else {
			$_PLUGINS->trigger( 'activity_onBeforeCreateStreamActivity', [ $this->rowStream, $source, &$this->row ] );
		}

		if ( ( $message === '' ) && ( $this->row->getRequiresMessage() || $this->rowStream->getParams()->getRequireMessage() ) ) {
			$this->ajax( CBTxt::T( 'Please provide a post.' ), 'warning' );
		}

		if ( $this->row->getError() || ( ! $this->row->check() ) || ( ! $this->row->store() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_EDIT_FAILED_TO_SAVE', 'Post failed to save! Error: [error]', [ '[error]' => $this->row->getError() ] ), 'error' );
		}

		if ( $this->rowStream->getParams()->canAccessTags( $this->row->getUserId() ) ) {
			$this->saveTags( $isNew );
		}

		if ( $this->rowStream->getParams()->canAccessMentions( $this->row->getUserId() ) ) {
			$this->saveMentions( $isNew );
		}

		if ( $this->rowStream->getParams()->canAccessHashtags( $this->row->getUserId() ) ) {
			$this->saveHashtags( $isNew );
		}

		if ( $this->rowStream->getParams()->canAccessFlair( $this->row->getUserId() ) ) {
			$this->saveFlairs( $isNew );
		}

		if ( $this->rowStream->getParams()->canAccessPrivacy( $this->row->getUserId() ) ) {
			$this->savePrivacy( $isNew );
		}

		if ( $isNew && $this->rowStream->getParams()->canAccessGallery( $this->row->getUserId() ) ) {
			$gallery						=	GalleryHelper::getMediaGallery( $this->row, $this->rowStream );

			if ( $gallery ) {
				$gallery->updateHold( 'activity.' . $this->row->getId(), $this->row->getParams()->getGalleryMedia() );
			}
		}

		if ( $hadPoll ) {
			$query							=	"DELETE"
											.	" FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_votes' )
											.	" WHERE " . $_CB_database->NameQuote( 'activity_id' ) . " = " . $this->row->getId();
			$_CB_database->setQuery( $query );
			$_CB_database->query();
		}

		if ( $isNew ) {
			if ( NotificationLogParams::getActivityCreate( $this->row->getUserId() ) ) {
				( new NotificationEntity( $this->row->getStream()->getAsset()->getPrefix() . 'activity.' . $this->row->getId() ) )
													->setUserId( $this->row->getUserId() )
													->setSystem( $this->row->getSystem() )
													->setRelationRecipients( NotificationLogParams::getActivityCreateRecipients(), NotificationLogParams::getActivityCreateRecipient() )
													->store();
			}

			if ( $this->row->getSystem() && NotificationLogParams::getSystemActivityCreate( $this->row->getUserId() ) ) {
				( new NotificationEntity( $this->row->getStream()->getAsset()->getPrefix() . 'activity.' . $this->row->getId() ) )
													->setUserId( $this->row->getUserId() )
													->setSystem( $this->row->getSystem() )
													->setRelationRecipients( NotificationLogParams::getSystemActivityCreateRecipients(), NotificationLogParams::getSystemActivityCreateRecipient() )
													->store();
			} elseif ( Application::MyUser()->isGlobalModerator() && NotificationLogParams::getModeratorActivityCreate( $this->row->getUserId() ) ) {
				( new NotificationEntity( $this->row->getStream()->getAsset()->getPrefix() . 'activity.' . $this->row->getId() ) )
													->setUserId( $this->row->getUserId() )
													->setSystem( $this->row->getSystem() )
													->setRelationRecipients( NotificationLogParams::getModeratorActivityCreateRecipients(), NotificationLogParams::getModeratorActivityCreateRecipient() )
													->store();
			}

			$profileId						=	$this->stream->getAsset()->getObjectIdOf( 'profile' );

			if ( $profileId ) {
				if ( NotificationLogParams::getProfileActivityCreate( $this->row->getUserId() ) ) {
					( new NotificationEntity( 'activity.' . $this->row->getId() ) )
													->setUserId( $this->row->getUserId() )
													->setSystem( $this->row->getSystem() )
													->setRelationRecipients( NotificationLogParams::getProfileActivityCreateRecipients(), NotificationLogParams::getProfileActivityCreateRecipient() )
													->store();
				}

				if ( ( $profileId === $this->row->getUserId() ) && NotificationLogParams::getMyProfileActivityCreate( $this->row->getUserId() ) ) {
					( new NotificationEntity( 'activity.' . $this->row->getId() ) )
													->setUserId( $this->row->getUserId() )
													->setSystem( $this->row->getSystem() )
													->setRelationRecipients( NotificationLogParams::getMyProfileActivityCreateRecipients(), NotificationLogParams::getMyProfileActivityCreateRecipient() )
													->store();
				}

				if ( ( $profileId !== $this->row->getUserId() ) && NotificationLogParams::getOwnProfileActivityCreate( $profileId ) ) {
					( new NotificationEntity( 'activity.' . $this->row->getId() ) )
														->setUserId( $this->row->getUserId() )
														->setSystem( $this->row->getSystem() )
														->setRecipients( [ $profileId ] )
														->store();
				}
			}
		}

		if ( ! $isNew ) {
			$_PLUGINS->trigger( 'activity_onAfterUpdateStreamActivity', [ $this->rowStream, $source, $this->row, $old ] );
		} else {
			$_PLUGINS->trigger( 'activity_onAfterCreateStreamActivity', [ $this->rowStream, $source, $this->row ] );
		}

		if ( $this->row->getError() ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_EDIT_PARTIAL_SAVE', 'Post partially saved! Error: [error]', [ '[error]' => $this->row->getError() ] ), 'error' );
		}

		ActivityHelper::addActivityCache( $this->row );

		if ( ( $isNew || $isNowPending ) && $this->row->isPending() ) {
			$notifyBy						=	$this->rowStream->getParams()->getCreateApprovalNotify();

			if ( $notifyBy ) {
				$cbUser						=	CBuser::getInstance( $this->row->getUserId(), false );

				$extraStrings				=	[	'activity'			=>	'<a href="' . $_CB_framework->pluginClassUrl( 'cbactivity', true, [ 'action' => 'activity', 'id' => $this->row->getId(), 'Itemid' => ActivityHelper::getStreamMenuId( $this->row->getStreamId() ) ] ) . '">' . $this->row->getNotificationTitle() . '</a>',
													'activity_id'		=>	$this->row->getId(),
													'activity_title'	=>	$this->row->getTitle(),
													'activity_message'	=>	$this->row->getMessage(),
													'activity_url'		=>	$_CB_framework->pluginClassUrl( 'cbactivity', true, [ 'action' => 'activity', 'id' => $this->row->getId(), 'Itemid' => ActivityHelper::getStreamMenuId( $this->row->getStreamId() ) ] ),
													'user'				=>	'<a href="' . $_CB_framework->viewUrl( 'userprofile', true, [ 'user' => $this->row->getUserId() ] ) . '">' . $this->row->getOwnerName( false, true, false ) . '</a>',
													'user_name'			=>	$this->row->getOwnerName( false, true, false ),
													'user_url'			=>	$_CB_framework->viewUrl( 'userprofile', true, [ 'user' => $this->row->getUserId() ] )
												];

				$subject					=	$cbUser->replaceUserVars( CBTxt::T( 'ACTIVITY_PENDING_NOTIFY_SUBJ', 'Post - Pending Approval!' ), false, true, $extraStrings, false );
				$message					=	$cbUser->replaceUserVars( CBTxt::T( 'ACTIVITY_PENDING_NOTIFY_MSG', '[user] posted "[activity]" and requires approval.' ), false, true, $extraStrings, false );

				NotificationsHelper::sendNotification( $notifyBy, $this->rowStream->getModerators( $this->row ), $this->row->getUserId(), $this->row->getStream()->getAsset()->getPrefix() . 'activity.' . $this->row->getId() . '.pending', $subject, $message, $this->row->getSystem() );
			}
		}

		$template							=	$this->template;
		$stream								=	$this->stream;
		$row								=	$this->row;
		$rowStream							=	$this->rowStream;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container', $this->template );

		echo $this->headers();
		$html								=	ob_get_clean();

		$this->ajax( $html );
	}

	/**
	 * @param bool $isNew
	 * @return void
	 */
	private function saveTags( bool $isNew = true ): void
	{
		global $_CB_database, $_PLUGINS;

		$tags						=	$this->input->getRaw( 'tags', [] );
		$limit						=	$this->rowStream->getParams()->getTagsLimit();

		if ( $limit ) {
			$tags					=	\array_slice( $tags, 0, $limit );
		}

		if ( ! $isNew ) {
			$query					=	"SELECT *"
									.	"\n FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_tags' )
									.	"\n WHERE " . $_CB_database->NameQuote( 'activity_id' ) . " = " . $this->row->getId();
			$_CB_database->setQuery( $query );
			$rows					=	$_CB_database->loadObjectList( 'id', TagTable::class, [ $_CB_database ] );

			foreach ( $rows as $tag ) {
				/** @var TagTable $tag */
				if ( ! \in_array( $tag->getTag(), $tags, true ) ) {
					$_PLUGINS->trigger( 'activity_onBeforeDeleteActivityStreamTag', [ $this->rowStream, $this->row, &$tag ] );

					if ( $tag->getError() || ( ! $tag->canDelete() ) || ( ! $tag->delete() ) ) {
						continue;
					}

					$_PLUGINS->trigger( 'activity_onAfterDeleteActivityStreamTag', [ $this->rowStream, $this->row, $tag ] );
				} else {
					$key			=	array_search( $tag->getTag(), $tags, true );

					if ( $key !== false ) {
						unset( $tags[$key] );
					}
				}
			}
		}

		foreach ( $tags as $tagUser ) {
			if ( is_numeric( $tagUser ) ) {
				$tagUser	=	(int) $tagUser;

				switch ( $this->rowStream->getParams()->getTagsWho() ) {
					case 6: // Specific Usergroups
						if ( ! array_intersect( Application::User( $tagUser )->getAuthorisedGroups(), $this->rowStream->getParams()->getTagsWhoUsergroups() ) ) {
							continue 2;
						}
						break;
					case 5: // Likes Only
						if ( ! LikesHelper::isUserLiked( $tagUser, $this->row->getUserId() ) ) {
							continue 2;
						}
						break;
					case 4: // Follows Only
						if ( ! FollowingHelper::isUserFollowed( $tagUser, $this->row->getUserId() ) ) {
							continue 2;
						}
						break;
					case 3: // Moderators Only
						if ( ! \in_array( $tagUser, UsersHelper::getModerators(), true ) ) {
							continue 2;
						}
						break;
					case 2: // Connections Only
						if ( ! \in_array( $tagUser, UsersHelper::getConnections( $this->row->getUserId() ), true ) ) {
							continue 2;
						}
						break;
				}
			} else {
				$tagUser	=	Get::clean( $tagUser, GetterInterface::STRING );
			}

			$tag			=	new TagTable();

			$tag->setUserId( $this->row->getUserId() );
			$tag->setActivityId( $this->row->getId() );
			$tag->setTag( $tagUser );

			$_PLUGINS->trigger( 'activity_onBeforeCreateActivityStreamTag', [ $this->rowStream, $this->row, &$tag ] );

			if ( $tag->getError() || ( ! $tag->check() ) || ( ! $tag->store() ) ) {
				continue;
			}

			$_PLUGINS->trigger( 'activity_onAfterCreateActivityStreamTag', [ $this->rowStream, $this->row, $tag ] );

			if ( $tag->getTagUserId() && ( $this->row->getUserId() !== $tag->getTagUserId() ) ) {
				if ( NotificationLogParams::getActivityTag( $this->row->getUserId() ) ) {
					( new NotificationEntity( $this->row->getStream()->getAsset()->getPrefix() . 'activity.' . $this->row->getId() . '.tag' ) )
							->setUserId( $tag->getTagUserId() )
							->setAccess( $this->row->getAccess() )
							->setPublished( $this->row->getPublished() )
							->setConditionedRecipients( NotificationLogParams::getActivityTagOwner(),
														$tag->getTagUserId(),
														NotificationLogParams::getActivityTagRecipients(),
														NotificationLogParams::getActivityTagRecipient() )
							->store();
				}

				if ( ActivityLogParams::getActivityTag( $tag->getTagUserId() ) ) {
					( new ActivityEntity( $this->row->getStream()->getAsset()->getPrefix() . 'activity.' . $this->row->getId() . '.tag' ) )
							->setUserId( $tag->getTagUserId() )
							->setAccess( $this->row->getAccess() )
							->setPublished( $this->row->getPublished() )
							->setCommentsStreamId( ( $this->row->getAsset()->isObjectOf( 'profile' ) ? 2 : 0 ) )
							->store();
				}
			}
		}

		TagsHelper::resetTotals( $this->row->getId() );
	}

	/**
	 * @param bool $isNew
	 * @return void
	 */
	private function saveMentions( bool $isNew = true ): void
	{
		global $_CB_database, $_PLUGINS;

		$mentions			=	$this->rowStream->getParser( $this->row->getMessage() )->getMentions();

		if ( ! $isNew ) {
			$query			=	"SELECT *"
							.	"\n FROM " . $_CB_database->NameQuote( '#__comprofiler_plugin_activity_mentions' )
							.	"\n WHERE " . $_CB_database->NameQuote( 'activity_id' ) . " = " . $this->row->getId();
			$_CB_database->setQuery( $query );
			$rows			=	$_CB_database->loadObjectList( null, ActivityMentionTable::class, [ $_CB_database ] );

			foreach ( $rows as $mention ) {
				/** @var ActivityMentionTable $mention */
				if ( ! \in_array( $mention->getUserId(), $mentions, true ) ) {
					$_PLUGINS->trigger( 'activity_onBeforeDeleteActivityStreamMention', [ $this->rowStream, $this->row, &$mention ] );

					if ( $mention->getError() || ( ! $mention->canDelete() ) || ( ! $mention->delete() ) ) {
						continue;
					}

					$_PLUGINS->trigger( 'activity_onAfterDeleteActivityStreamMention', [ $this->rowStream, $this->row, $mention ] );
				} else {
					$key	=	array_search( $mention->getUserId(), $mentions, true );

					if ( $key !== false ) {
						unset( $mentions[$key] );
					}
				}
			}
		}

		foreach ( $mentions as $userId ) {
			if ( ! CBuser::getUserDataInstance( $userId )->getInt( 'id', 0 ) ) {
				continue;
			}

			$mention		=	new ActivityMentionTable();

			$mention->setActivityId( $this->row->getId() );
			$mention->setUserId( $userId );

			$_PLUGINS->trigger( 'activity_onBeforeCreateActivityStreamMention', [ $this->rowStream, $this->row, &$mention ] );

			if ( $mention->getError() || ( ! $mention->check() ) || ( ! $mention->store() ) ) {
				continue;
			}

			$_PLUGINS->trigger( 'activity_onAfterCreateActivityStreamMention', [ $this->rowStream, $this->row, $mention ] );

			if ( $mention->getUserId() && ( $this->row->getUserId() !== $mention->getUserId() ) ) {
				if ( NotificationLogParams::getActivityMention( $this->row->getUserId() ) ) {
					( new NotificationEntity( $this->row->getStream()->getAsset()->getPrefix() . 'activity.' . $this->row->getId() . '.mention' ) )
							->setUserId( $mention->getUserId() )
							->setAccess( $this->row->getAccess() )
							->setPublished( $this->row->getPublished() )
							->setConditionedRecipients( NotificationLogParams::getActivityMentionOwner(),
														$mention->getUserId(),
														NotificationLogParams::getActivityMentionRecipients(),
														NotificationLogParams::getActivityMentionRecipient() )
							->store();
				}

				if ( $mention->getUserId() && ( $this->row->getUserId() !== $mention->getUserId() ) && ActivityLogParams::getActivityMention( $mention->getUserId() ) ) {
					( new ActivityEntity( $this->row->getStream()->getAsset()->getPrefix() . 'activity.' . $this->row->getId() . '.mention' ) )
							->setUserId( $mention->getUserId() )
							->setAccess( $this->row->getAccess() )
							->setPublished( $this->row->getPublished() )
							->setCommentsStreamId( ( $this->row->getAsset()->isObjectOf( 'profile' ) ? 2 : 0 ) )
							->store();
				}
			}
		}
	}

