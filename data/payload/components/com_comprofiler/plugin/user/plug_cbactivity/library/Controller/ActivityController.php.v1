	}

	/**
	 * @return void
	 */
	public function report(): void
	{
		global $_CB_framework, $_PLUGINS;

		$hidden					=	new HiddenTable();

		$hidden->load( [ 'user_id' => $this->myId, 'type' => 'activity', 'object' => $this->row->getId() ] );

		if ( $hidden->getId() ) {
			$this->ajax( CBTxt::T( 'You have already reported this post.' ), 'error' );
		}

		$source					=	$this->row->getSource();

		$this->row->setReports( ( $this->row->getReports() + 1 ) );

		$reportLimit			=	GlobalParams::getReportingLimit();

		if ( $reportLimit && ( $this->row->getReports() >= $reportLimit ) ) {
			$this->row->setPublished( 0 );
		}

		if ( ! $hidden->getId() ) {
			$hidden->setUserId( $this->myId );
			$hidden->setType( 'activity' );
			$hidden->setObject( $this->row->getId() );

			$_PLUGINS->trigger( 'activity_onBeforeActivityStreamHide', [ $this->rowStream, $source, &$hidden, $this->row ] );

			if ( $hidden->getError() || ( ! $hidden->check() ) || ( ! $hidden->store() ) ) {
				$this->ajax( CBTxt::T( 'ACTIVITY_HIDE_FAILED_TO_SAVE', 'Post failed to hide! Error: [error]', [ '[error]' => $hidden->getError() ] ), 'error' );
			}

			$this->row->set( '_hidden_id', $hidden->getObject() );

			$_PLUGINS->trigger( 'activity_onAfterActivityStreamHide', [ $this->rowStream, $source, $hidden, $this->row ] );
		}

		$_PLUGINS->trigger( 'activity_onBeforeActivityStreamReport', [ $this->rowStream, $source, &$this->row ] );

		if ( $this->row->getError() || ( ! $this->row->check() ) || ( ! $this->row->store() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_REPORT_FAILED_TO_SAVE', 'Post failed to report! Error: [error]', [ '[error]' => $this->row->getError() ] ), 'error' );
		}

		$_PLUGINS->trigger( 'activity_onAfterActivityStreamReport', [ &$this->rowStream, $source, $this->row ] );

		ActivityHelper::addActivityCache( $this->row );

		$notifyBy				=	GlobalParams::getReportingNotify();

		if ( $notifyBy ) {
			$cbUser				=	CBuser::getInstance( $this->myId, false );

			$extraStrings		=	[	'activity'			=>	'<a href="' . $_CB_framework->pluginClassUrl( 'cbactivity', true, [ 'action' => 'activity', 'id' => $this->row->getId(), 'Itemid' => ActivityHelper::getStreamMenuId( $this->row->getStreamId() ) ] ) . '">' . $this->row->getNotificationTitle() . '</a>',
										'activity_id'		=>	$this->row->getId(),
										'activity_title'	=>	$this->row->getTitle(),
										'activity_message'	=>	$this->row->getMessage(),
										'activity_url'		=>	$_CB_framework->pluginClassUrl( 'cbactivity', true, [ 'action' => 'activity', 'id' => $this->row->getId(), 'Itemid' => ActivityHelper::getStreamMenuId( $this->row->getStreamId() ) ] ),
										'user'				=>	'<a href="' . $_CB_framework->viewUrl( 'userprofile', true, [ 'user' => $this->myId ] ) . '">' . HtmlHelper::getUserName( $this->myId, false, null, false ) . '</a>',
										'user_name'			=>	HtmlHelper::getUserName( $this->myId, false, null, false ),
										'user_url'			=>	$_CB_framework->viewUrl( 'userprofile', true, [ 'user' => $this->myId ] )
									];

			$subject			=	$cbUser->replaceUserVars( CBTxt::T( 'ACTIVITY_REPORTED_NOTIFY_SUBJ', 'Post - Reported!' ), false, true, $extraStrings, false );

			if ( ! $this->row->getPublished() ) {
				$message		=	$cbUser->replaceUserVars( CBTxt::T( 'ACTIVITY_REPORTED_NOTIFY_MSG_UNPUBLISHED', '[user] reported post "[activity]" as controversial and has now been unpublished!' ), false, true, $extraStrings, false );
			} else {
				$message		=	$cbUser->replaceUserVars( CBTxt::T( 'ACTIVITY_REPORTED_NOTIFY_MSG', '[user] reported post "[activity]" as controversial!' ), false, true, $extraStrings, false );
			}

			NotificationsHelper::sendNotification( $notifyBy, $this->rowStream->getModerators( $this->row ), $this->row->getUserId(), $this->row->getStream()->getAsset()->getPrefix() . 'activity.' . $this->row->getId() . '.reported', $subject, $message );
		}

		$template				=	$this->template;
		$stream					=	$this->stream;
		$row					=	$this->row;
		$rowStream				=	$this->rowStream;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container_reported', $this->template );
		$html					=	ob_get_clean();

		$this->ajax( $html, 'html', 'replace', 'container' );
	}

	/**
	 * @return bool
	 */
	public function authorizedRepost(): bool
	{
		return ( $this->isRaw && $this->csrf() && $this->row && $this->rowStream->canShareActivity( $this->row ) && $this->rowStream->getParams()->getShareRepost() );
	}

	/**
	 * @return void
	 */
	public function repost(): void
	{
		global $_PLUGINS;

		$row					=	new ActivityTable();
		$rowStream				=	ActivityHelper::getStream( $this->rowStream->getParams()->getShareRepostStream() );

		$repostAsset			=	'activity.' . $this->row->getId() . '.repost';

		$row->load( [ 'stream_id' => $rowStream->getId(), 'user_id' => $this->myId, 'asset' => $repostAsset ] );

		if ( $row->getId() ) {
			$this->ajax( CBTxt::T( 'You have already reposted this post.' ), 'error' );
		}

		$row->setStreamId( $rowStream->getId() );
		$row->setUserId( $this->myId );
		$row->setAsset( $repostAsset );

		if ( $rowStream->getParams()->getCreateApproval() && ( ! $rowStream->canModerate( $row ) ) ) {
			$row->setPublished( 2 );
		} else {
			$row->setPublished( 1 );
		}

		$_PLUGINS->trigger( 'activity_onBeforeCreateStreamActivity', [ $rowStream, $this->row, &$row ] );

		if ( $row->getError() || ( ! $row->check() ) || ( ! $row->store() ) ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_FAILED_TO_REPOST', 'Post failed to repost! Error: [error]', [ '[error]' => $row->getError() ] ), 'error' );
		}

		if ( NotificationLogParams::getActivityShare( $this->myId ) ) {
			( new NotificationEntity( 'activity.' . $this->row->getId() . '.repost' ) )
					->setUserId( $this->myId )
					->setConditionedRecipients( NotificationLogParams::getActivityShareOwner(),
												$this->row->getUserId(),
												NotificationLogParams::getActivityShareRecipients(),
												NotificationLogParams::getActivityShareRecipient() )
					->store();
		}

		$_PLUGINS->trigger( 'activity_onAfterCreateStreamActivity', [ $rowStream, $this->row, $row ] );

		if ( $row->getError() ) {
			$this->ajax( CBTxt::T( 'ACTIVITY_FAILED_TO_REPOST', 'Post failed to repost! Error: [error]', [ '[error]' => $row->getError() ] ), 'error' );
		}

		ActivityHelper::addActivityCache( $row );

		$template				=	$this->template;
		$stream					=	$this->stream;
		$row					=	$this->row;

		ob_start();
		require HtmlHelper::getTemplate( 'activity/container', $this->template );

		echo $this->headers();
		$html					=	ob_get_clean();

		$this->ajax( $html, 'html', 'prepend', 'items', 'stream', true );
	}

