<?xml version="1.0" encoding="UTF-8"?>
<patch hashType="sha256">
    <description>CB Gallery and CB Activity controller fixes and CBSubs language overrides</description>

    <root path="components/com_comprofiler/plugin/user/plug_cbgallery/library/Controller">
        <object version="1">
            <id>
                <destPathFileName>FolderController.php</destPathFileName>
                <expectedHash>43c7e6512a9c1b91a885a4ddafce03189751db1bd28ac4a1c68c29cedc49006d</expectedHash>
                <description>CB Gallery 4.1.2+build.2026.08.03 stock folder controller</description>
            </id>
            <action>
                <description>
                    Folder share link uses the current gallery's id and encoded asset.
                    The vendor fills those from a different gallery and then uses them
                    unconditionally, so the ordinary same-gallery case drops the context.
                    Vendor file has no trailing newline; the payload keeps that.
                </description>
                <operations>
                    <copy>
                        <srcPathFileName>components/com_comprofiler/plugin/user/plug_cbgallery/library/Controller/FolderController.php.v1</srcPathFileName>
                        <!-- payload: LF, no trailing newline -->
                        <sourceHash>7b8d9d0397cd1c079492492d77f7dc3d7ddd4bb9c6fa9010e80f676962dba0d0</sourceHash>
                    </copy>
                </operations>
            </action>
        </object>

        <object version="2">
            <id>
                <destPathFileName>FolderController.php</destPathFileName>
                <expectedHash>7b8d9d0397cd1c079492492d77f7dc3d7ddd4bb9c6fa9010e80f676962dba0d0</expectedHash>
                <description>The version 1 payload, so a site already carrying it advances</description>
            </id>
            <action>
                <description>
                    The bytes the live site runs. Same fix as version 1, plus the
                    ECSKC Customisation marker comment and a trailing newline, which
                    is how the file was actually deployed. Version 1 stays as the
                    vendor-cut record so an overwrite by CB Gallery is still
                    recognised; the walk then carries the target through it to here.
                </description>
                <operations>
                    <copy>
                        <srcPathFileName>components/com_comprofiler/plugin/user/plug_cbgallery/library/Controller/FolderController.php.v2</srcPathFileName>
                        <!-- payload: LF, trailing newline -->
                        <sourceHash>ec454993d366c563f99610787df4f400418dbdced1504aed890c3d6ab5feb974</sourceHash>
                    </copy>
                </operations>
            </action>
        </object>
    </root>

    <root path="components/com_comprofiler/plugin/user/plug_cbactivity/library/Controller">
        <object version="1">
            <id>
                <destPathFileName>ActivityController.php</destPathFileName>
                <expectedHash>f1f836fa324109ea3bd6cf5b54223305d24ea0c9f329682fbe6e71a1a4b1b51f</expectedHash>
                <description>CB Activity 7.1.0+build.2026.08.31.17.16.12.c39deb025 stock activity controller</description>
            </id>
            <action>
                <description>
                    The getRows() refill passes the current date filter on. The vendor
                    passes the loop counter in the date's place, so the second refill
                    filters on a.date &gt;= '1' and MySQL rejects the query (error 1525).
                    Only that argument changes. Vendor file and payload are each
                    139049 bytes, LF, with no trailing newline.
                </description>
                <operations>
                    <copy>
                        <srcPathFileName>components/com_comprofiler/plugin/user/plug_cbactivity/library/Controller/ActivityController.php.v1</srcPathFileName>
                        <!-- payload: LF, no trailing newline -->
                        <sourceHash>8b72a092f18b161c4c63b411f83de9702595ec9046ecfb79a6296cc9d3bd3b16</sourceHash>
                    </copy>
                </operations>
            </action>
        </object>
    </root>

    <root path="components/com_comprofiler/plugin/language/cbpaidsubscriptions-en-gb">
        <object version="1" create="true">
            <id>
                <destPathFileName>override.php</destPathFileName>
                <description>Site-specific CBSubs wording. CBSubs ships no such folder.</description>
            </id>
            <action>
                <description>CBSubs English override strings as they run on the site</description>
                <operations>
                    <copy>
                        <srcPathFileName>components/com_comprofiler/plugin/language/cbpaidsubscriptions-en-gb/override.php.v1</srcPathFileName>
                        <!-- payload: LF, trailing newline -->
                        <sourceHash>628715b1af5db6faf82811eb60c468acb2f738f9b7a02f073ac6bdba060a6404</sourceHash>
                    </copy>
                </operations>
            </action>
        </object>
        <object version="1" create="true">
            <id>
                <destPathFileName>language.php</destPathFileName>
                <description>Required return array(); stub for the CBSubs override mechanism</description>
            </id>
            <action>
                <operations>
                    <copy>
                        <srcPathFileName>components/com_comprofiler/plugin/language/cbpaidsubscriptions-en-gb/language.php.v1</srcPathFileName>
                        <!-- payload: CRLF, no trailing newline -->
                        <sourceHash>6b840f894b6af4eacbf1f6499cff4b8dea04b6477ac90ac85e9fd60621b036c6</sourceHash>
                    </copy>
                </operations>
            </action>
        </object>
    </root>
</patch>
