<?xml version="1.0" encoding="UTF-8"?>
<patch hashType="sha256">
    <description>CB GroupJive guest query fixes and CBSubs language overrides</description>

    <root path="components/com_comprofiler/plugin/user/plug_cbgroupjive/plugins/cbgroupjiveevents">
        <object version="1">
            <id>
                <destPathFileName>component.cbgroupjiveevents.php</destPathFileName>
                <expectedHash>72e42fd97e1d9629bba7df9fee0f174e11a12ce07938ffa9c07da841e4c15631</expectedHash>
                <description>CB GroupJive Events 4.0.1 (manifest version 2.12.0) stock component</description>
            </id>
            <action>
                <description>
                    The guest branch of the events count and list queries adds its two
                    group conditions without a leading AND. The vendor keeps the AND
                    from 3.7.0, where the conditions were appended to the query, but
                    4.0.1 joins them with AND, so a guest gets "AND AND" and a SQL
                    syntax error. Only those four strings change. Vendor file and
                    payload are LF with no trailing newline.
                </description>
                <operations>
                    <copy>
                        <srcPathFileName>components/com_comprofiler/plugin/user/plug_cbgroupjive/plugins/cbgroupjiveevents/component.cbgroupjiveevents.php.v1</srcPathFileName>
                        <!-- payload: LF, no trailing newline -->
                        <sourceHash>9818700e727c2ce7b4a172aff69dbf6baacfb015469e78ffeb077d88d1a9fe27</sourceHash>
                    </copy>
                </operations>
            </action>
        </object>
    </root>

    <root path="modules/mod_cbgroupjive/src/Dispatcher">
        <object version="1">
            <id>
                <destPathFileName>Dispatcher.php</destPathFileName>
                <expectedHash>7de8dfec38f448ac727035dbd94d28776aa2489d07939e7274b8b1adcf08cb54</expectedHash>
                <description>CB GroupJive module 4.0.1 stock dispatcher</description>
            </id>
            <action>
                <description>
                    The events mode has the same guest-branch fault as the GroupJive
                    Events component: two conditions keep a leading AND and are then
                    joined with AND. Any page showing the module to a guest, the home
                    page included, fails with a SQL syntax error. Only those two
                    strings change. Vendor file and payload are LF with a trailing newline.
                </description>
                <operations>
                    <copy>
                        <srcPathFileName>modules/mod_cbgroupjive/src/Dispatcher/Dispatcher.php.v1</srcPathFileName>
                        <!-- payload: LF, trailing newline -->
                        <sourceHash>42caa28d7efc42778e13b95f40c5cf230627cc9872b9ca3450765d3791885cbe</sourceHash>
                    </copy>
                </operations>
            </action>
        </object>
    </root>

    <root path="components/com_comprofiler/plugin/language/cbpaidsubscriptions-en-gb">
        <object version="1" create="true">
            <id>
                <destPathFileName>override.php</destPathFileName>
                <description>Site-specific CBSubs wording. CBSubs ships no such folder.</description>
            </id>
            <action>
                <description>CBSubs English override strings as they run on the site</description>
                <operations>
                    <copy>
                        <srcPathFileName>components/com_comprofiler/plugin/language/cbpaidsubscriptions-en-gb/override.php.v1</srcPathFileName>
                        <!-- payload: LF, trailing newline -->
                        <sourceHash>628715b1af5db6faf82811eb60c468acb2f738f9b7a02f073ac6bdba060a6404</sourceHash>
                    </copy>
                </operations>
            </action>
        </object>
        <object version="1" create="true">
            <id>
                <destPathFileName>language.php</destPathFileName>
                <description>Required return array(); stub for the CBSubs override mechanism</description>
            </id>
            <action>
                <operations>
                    <copy>
                        <srcPathFileName>components/com_comprofiler/plugin/language/cbpaidsubscriptions-en-gb/language.php.v1</srcPathFileName>
                        <!-- payload: CRLF, no trailing newline -->
                        <sourceHash>6b840f894b6af4eacbf1f6499cff4b8dea04b6477ac90ac85e9fd60621b036c6</sourceHash>
                    </copy>
                </operations>
            </action>
        </object>
    </root>
</patch>
