        </id>
        <action>
            <operations>
                <copy>
                    <srcPathFileName>apple-touch-icon-precomposed.png.v1</srcPathFileName>
                    <!-- payload: PNG; line endings do not apply -->
                    <sourceHash>9060286ff7e33a812d43a314bc00ed6f4ef1c72a2ca9cd9fc718a2be3693231b</sourceHash>
                </copy>
